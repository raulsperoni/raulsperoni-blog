{
  "title": "Raúl Speroni Blog",
  "description": "Content management for blog posts and links",
  "collections": [
    {
      "name": "blog",
      "label": "Blog Posts",
      "path": "src/content/blog",
      "format": "md",
      "fields": [
        {
          "name": "title",
          "label": "Title",
          "type": "string",
          "required": true
        },
        {
          "name": "description",
          "label": "Description",
          "type": "text",
          "required": true
        },
        {
          "name": "pubDate",
          "label": "Publication Date",
          "type": "date",
          "required": true
        },
        {
          "name": "updatedDate",
          "label": "Updated Date",
          "type": "date",
          "required": false
        },
        {
          "name": "heroImage",
          "label": "Hero Image",
          "type": "image",
          "required": false,
          "description": "Path relative to src/assets/images/"
        },
        {
          "name": "tags",
          "label": "Tags",
          "type": "list",
          "required": false,
          "default": []
        }
      ]
    },
    {
      "name": "links",
      "label": "Links",
      "path": "src/content/links",
      "format": "md",
      "fields": [
        {
          "name": "title",
          "label": "Title",
          "type": "string",
          "required": true
        },
        {
          "name": "url",
          "label": "URL",
          "type": "string",
          "required": true,
          "description": "The link URL"
        },
        {
          "name": "description",
          "label": "Description",
          "type": "text",
          "required": true
        },
        {
          "name": "pubDate",
          "label": "Publication Date",
          "type": "date",
          "required": true
        },
        {
          "name": "ogImage",
          "label": "OG Image URL",
          "type": "string",
          "required": false,
          "description": "Open Graph image URL"
        },
        {
          "name": "favicon",
          "label": "Favicon URL",
          "type": "string",
          "required": false
        },
        {
          "name": "siteName",
          "label": "Site Name",
          "type": "string",
          "required": false
        },
        {
          "name": "linkImage",
          "label": "Custom Image",
          "type": "image",
          "required": false,
          "description": "Optional screenshot or custom image"
        },
        {
          "name": "tags",
          "label": "Tags",
          "type": "list",
          "required": false,
          "default": []
        }
      ]
    }
  ],
  "media": {
    "input": "src/assets/images",
    "output": "src/assets/images"
  }
}
