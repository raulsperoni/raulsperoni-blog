---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<div class="footer-left">
			<span class="footer-name">Raúl Speroni</span>
			<span class="footer-sep">—</span>
			<span class="footer-year">{today.getFullYear()}</span>
		</div>
		<div class="social-links">
			<a href="/recetas/">recetas</a>
			<a href="https://bsky.app/profile/raulsperoni.me" target="_blank" rel="noopener noreferrer">Bluesky</a>
			<a href="https://www.linkedin.com/in/raulsperoni/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
			<a href="https://github.com/raulsperoni" target="_blank" rel="noopener noreferrer">GitHub</a>
		</div>
	</div>
</footer>

<style>
	footer {
		margin-top: 6rem;
		padding: 2.5rem 0;
		border-top: 1px solid var(--border);
		background: transparent;
	}

	.footer-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 960px;
		max-width: calc(100% - 3rem);
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	.footer-left {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--text-light);
		opacity: 0.7;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		letter-spacing: 0.04em;
	}

	.footer-name {
		font-style: italic;
		font-family: var(--font-display);
		font-size: 0.875rem;
	}

	.footer-sep {
		font-family: var(--font-mono);
		opacity: 0.4;
		font-size: 0.6rem;
	}

	.social-links {
		display: flex;
		gap: 1.5rem;
	}

	.social-links a {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		text-transform: lowercase;
		letter-spacing: 0.04em;
		color: var(--text-light);
		opacity: 0.6;
		border: none;
		text-decoration: none;
		transition: opacity 0.15s ease, color 0.15s ease;
	}

	.social-links a:hover {
		opacity: 1;
		color: var(--accent);
		border: none;
	}

	@media (max-width: 720px) {
		.footer-inner {
			flex-direction: column;
			gap: 1.25rem;
			text-align: center;
			padding: 0 1.25rem;
		}
	}
</style>
