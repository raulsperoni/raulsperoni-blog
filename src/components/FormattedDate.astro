---
interface Props {
	date: Date;
	// Spanish by default; English pages (TIL) pass 'en-US'.
	locale?: 'es-UY' | 'en-US';
}

const { date, locale = 'es-UY' } = Astro.props;
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString(locale, {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		})
	}
</time>
