---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<div class="header-left">
			<h1 class="site-title"><a href="/">{SITE_TITLE}</a></h1>
			<div class="internal-links">
				<HeaderLink href="/">Home</HeaderLink>
				<HeaderLink href="/blog">Blog</HeaderLink>
				<HeaderLink href="/links">Links</HeaderLink>
				<HeaderLink href="/fitness">Fitness</HeaderLink>
			</div>
		</div>
		<div class="social-links">
			<a href="https://bsky.app/profile/raulsperoni.me" target="_blank" aria-label="Follow on Bluesky">
				<svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18"
					><path
						fill="currentColor"
