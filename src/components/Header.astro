					></path></svg
				>
			</a>
			<a href="https://www.linkedin.com/in/raulsperoni/" target="_blank" aria-label="Follow on LinkedIn">
				<svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18"
					><path
						fill="currentColor"
						d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
					></path></svg
				>
			</a>
			<a href="https://github.com/raulsperoni" target="_blank" aria-label="GitHub">
				<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0;
		background: var(--bg-elevated);
		border-bottom: 1px solid var(--border);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 680px;
		margin: 0 auto;
		padding: 2rem 1.5rem;
	}

	.header-left {
		display: flex;
		align-items: center;
		gap: 2rem;
	}

	.site-title {
		margin: 0;
		font-size: 1.375rem;
		font-weight: 700;
		letter-spacing: -0.025em;
		font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
	}

	.site-title a {
		text-decoration: none;
		color: var(--text);
		border: none;
		transition: color 0.2s ease;
	}

	.site-title a:hover {
		color: var(--accent);
		border: none;
	}

	.internal-links {
		display: flex;
		gap: 0.25rem;
	}

	.internal-links :global(a) {
		padding: 0.5rem 0.75rem;
		color: var(--text-light);
		border: none;
		text-decoration: none;
		font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		font-size: 0.875rem;
		font-weight: 500;
		transition: color 0.2s ease;
	}

	.internal-links :global(a:hover) {
		color: var(--accent);
		border: none;
	}

	.internal-links :global(a.active) {
		color: var(--text);
		border: none;
	}

	.social-links {
		display: flex;
		gap: 1rem;
	}

	.social-links a {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.25rem;
		color: var(--text-light);
		opacity: 0.5;
		transition: opacity 0.2s ease, color 0.2s ease;
		border: none;
	}

	.social-links a:hover {
		opacity: 1;
		color: var(--accent);
		border: none;
	}

	@media (max-width: 720px) {
		nav {
			padding: 1.5rem 1rem;
			flex-direction: column;
			gap: 1.5rem;
		}

		.header-left {
			width: 100%;
			flex-direction: column;
			align-items: flex-start;
			gap: 1rem;
		}

		.social-links {
			width: 100%;
			justify-content: flex-start;
		}
	}
</style>
