---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, ogImage, tags } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={ogImage ?? heroImage} />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
			}

			.hero-image {
				width: 100%;
				margin: 0;
			}

			.hero-image img {
				display: block;
				width: 100%;
				margin: 0;
				border-radius: 0;
			}

			.prose {
				width: 680px;
				max-width: calc(100% - 3rem);
				margin: 0 auto;
				padding: 3rem 1.5rem 4rem;
			}

			.title {
				margin-bottom: 2rem;
				padding-bottom: 2rem;
				border-bottom: 1px solid var(--border);
			}

			.title h1 {
				margin: 0 0 1rem 0;
				font-size: 2.5rem;
			}

			.date {
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
				font-size: 0.875rem;
				color: var(--text-light);
				margin-bottom: 1rem;
			}

			.last-updated-on {
				font-style: italic;
				margin-top: 0.5rem;
			}

			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-top: 1rem;
			}

			.tag {
				padding: 0.375rem 0.75rem;
				background: var(--accent-light);
				color: var(--accent-dark);
				border-radius: var(--radius-sm);
				text-decoration: none;
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
				font-size: 0.8125rem;
				font-weight: 500;
				transition: all 0.2s ease;
				border: none;
			}

			.tag:hover {
				background: var(--accent);
				color: white;
				border: none;
			}

			.tag::before {
				content: '#';
				opacity: 0.7;
			}

			@media (max-width: 720px) {
				.title h1 {
					font-size: 2rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main id="main">
			<article>
				<div class="hero-image">
					{heroImage && <Image src={heroImage} alt="" width={1020} height={510} />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						{tags && tags.length > 0 && (
							<div class="tags">
								{tags.map((tag) => (
									<a href={`/tags/${tag}/`} class="tag">{tag}</a>
								))}
							</div>
						)}
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
