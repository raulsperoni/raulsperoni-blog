---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const allPosts = await getCollection('blog');
const allLinks = await getCollection('links');
const allStrava = await getCollection('strava');
const allGoodreads = await getCollection('goodreads');
const allTil = await getCollection('til');

const recentPosts = allPosts
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);

const allContent = [
	...allPosts.map(post => ({
		...post,
		type: 'blog' as const,
		url: `/blog/${post.id}/`
	})),
	...allLinks.map(link => ({
		...link,
		type: 'link' as const,
		url: `/links/${link.id}/`
	})),
	...allStrava.map(activity => ({
		...activity,
		type: 'strava' as const,
		url: activity.data.stravaUrl
	})),
	...allGoodreads.map(book => ({
		...book,
		type: 'goodreads' as const,
		url: book.data.goodreadsUrl
	})),
	...allTil.map(til => ({
		...til,
		type: 'til' as const,
		url: `/til/${til.id}/`
	}))
].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const tagMap = new Map<string, typeof allContent>();

allContent.filter(item => item.type !== 'til').forEach(item => {
	item.data.tags.forEach(tag => {
		if (!tagMap.has(tag)) {
			tagMap.set(tag, []);
		}
		tagMap.get(tag)!.push(item);
	});
});

// Sort tags: prefer blog+link count so "escribo"/"hago" rank above Strava-heavy tags
const sortedTags = Array.from(tagMap.entries())
	.sort((a, b) => {
		const nonStravaCount = (items: typeof allContent) =>
			items.filter((item) => item.type === 'blog' || item.type === 'link').length;
		const aNonStrava = nonStravaCount(a[1]);
		const bNonStrava = nonStravaCount(b[1]);
		if (bNonStrava !== aNonStrava) return bNonStrava - aNonStrava;
		return b[1].length - a[1].length;
	});

// Timeline
interface TimelineGroup {
	startDate: string;
	endDate: string;
	typeGroups: {
		type: string;
		items: typeof allContent;
	}[];
}

const TIMELINE_LIMIT = 30;
const CONDENSE_THRESHOLD = 3;

// Heatmap
const tagFrequency = new Map<string, number>();
allContent.forEach(item => {
	if (item.type === 'til') {
		tagFrequency.set('til', (tagFrequency.get('til') || 0) + 1);
	} else {
		item.data.tags.forEach(tag => {
			tagFrequency.set(tag, (tagFrequency.get(tag) || 0) + 1);
		});
	}
});

const topTags = Array.from(tagFrequency.entries())
	.sort((a, b) => b[1] - a[1])
	.slice(0, 5)
	.map(([tag]) => tag);

interface HeatmapDay {
	date: string;
	tagCounts: Map<string, number>;
	total: number;
}

const heatmapData: HeatmapDay[] = [];
const now = new Date();
const oneYearAgo = new Date(now);
oneYearAgo.setFullYear(now.getFullYear() - 1);

const activityMap = new Map<string, Map<string, number>>();

allContent.forEach(item => {
	const dateKey = item.data.pubDate.toISOString().split('T')[0];
	const itemDate = new Date(dateKey);

	if (itemDate >= oneYearAgo && itemDate <= now) {
		if (!activityMap.has(dateKey)) {
			activityMap.set(dateKey, new Map());
		}
		const tagCounts = activityMap.get(dateKey)!;
		if (item.type === 'til') {
			tagCounts.set('til', (tagCounts.get('til') || 0) + 1);
		} else {
			item.data.tags.forEach(tag => {
				tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
			});
		}
	}
});

const startDate = new Date(now);
startDate.setDate(now.getDate() - 363);

for (let i = 0; i < 364; i++) {
	const date = new Date(startDate);
	date.setDate(startDate.getDate() + i);
	const dateKey = date.toISOString().split('T')[0];

	const tagCounts = activityMap.get(dateKey) || new Map();
	const total = Array.from(tagCounts.values()).reduce((sum, count) => sum + count, 0);

	heatmapData.push({ date: dateKey, tagCounts, total });
}

const maxTotal = Math.max(...heatmapData.map(d => d.total), 1);

const tagColors = new Map<string, number>([
	[topTags[0], 210],
	[topTags[1], 20],
	[topTags[2], 150],
	[topTags[3], 280],
	[topTags[4], 45],
]);

// Build timeline
const dateGroups = new Map<string, typeof allContent>();
for (let i = 0; i < Math.min(allContent.length, TIMELINE_LIMIT); i++) {
	const item = allContent[i];
	const dateKey = item.data.pubDate.toISOString().split('T')[0];
	if (!dateGroups.has(dateKey)) dateGroups.set(dateKey, []);
	dateGroups.get(dateKey)!.push(item);
}

const sortedDates = Array.from(dateGroups.entries()).sort((a, b) =>
	new Date(b[0]).getTime() - new Date(a[0]).getTime()
);

const timeline: TimelineGroup[] = [];
for (const [date, items] of sortedDates) {
	const typeGroups: { type: string; items: typeof allContent }[] = [];

	for (const item of items) {
		const lastGroup = typeGroups[typeGroups.length - 1];
		if (lastGroup && lastGroup.type === item.type) {
			lastGroup.items.push(item);
		} else {
			typeGroups.push({ type: item.type, items: [item] });
		}
	}

	const lastTimelineGroup = timeline[timeline.length - 1];
	const isSingleType = typeGroups.length === 1;
	const lastIsSingleType = lastTimelineGroup && lastTimelineGroup.typeGroups.length === 1;

	if (lastTimelineGroup && isSingleType && lastIsSingleType &&
		typeGroups[0].type === lastTimelineGroup.typeGroups[0].type) {
		lastTimelineGroup.endDate = date;
		lastTimelineGroup.typeGroups[0].items.push(...typeGroups[0].items);
	} else {
		timeline.push({ startDate: date, endDate: date, typeGroups });
	}
}
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			/* — Intro — */
			.intro {
				padding: 3rem 0 2rem;
				margin-bottom: 2rem;
			}

			.intro-line {
				font-family: var(--font-display);
				font-size: clamp(1.375rem, 4vw, 1.875rem);
				line-height: 1.25;
				color: var(--text);
				margin: 0 0 1rem;
				letter-spacing: -0.01em;
			}

			.intro-sub {
				font-family: var(--font-mono);
				font-size: 0.65rem;
				color: var(--text-light);
				text-transform: uppercase;
				letter-spacing: 0.1em;
				margin: 0;
				opacity: 0.7;
			}

			/* — Recent posts — */
			.recent-posts {
				margin-bottom: 4rem;
			}

			.recent-post {
				display: grid;
				grid-template-columns: 6rem 1fr;
				gap: 0 2rem;
				padding: 1.5rem 0;
				border-bottom: 1px solid var(--border);
				align-items: start;
			}

			.recent-post:first-of-type {
				border-top: none;
			}

			.recent-post-date {
				font-family: var(--font-mono);
				font-size: 0.6rem;
				color: var(--text-light);
				text-transform: uppercase;
				letter-spacing: 0.06em;
				padding-top: 0.35rem;
				opacity: 0.65;
			}

			.recent-post-title {
				font-family: var(--font-display);
				font-size: 1.25rem;
				font-weight: 700;
				line-height: 1.2;
				color: var(--text);
				text-decoration: none;
				border: none;
				display: block;
				transition: color 0.15s ease;
			}

			.recent-post-title:hover {
				color: var(--accent);
			}

			.recent-post-desc {
				font-family: var(--font-body);
				font-size: 0.9rem;
				color: var(--text-light);
				line-height: 1.55;
				margin: 0.35rem 0 0;
			}

			.view-all {
				display: inline-block;
				margin-top: 1.25rem;
				font-family: var(--font-mono);
				font-size: 0.65rem;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: var(--text-light);
				text-decoration: none;
				border: none;
				opacity: 0.6;
				transition: opacity 0.15s ease, color 0.15s ease;
			}

			.view-all:hover {
				opacity: 1;
				color: var(--accent);
			}

			/* — Tags grid — */
			.tags-grid {
				display: grid;
				grid-template-columns: 1fr;
				gap: 0;
				margin-bottom: 4rem;
			}

			.tag-section {
				padding: 1.5rem 0;
				border-bottom: 1px solid var(--border);
			}

			.tag-section:last-child {
				border-bottom: none;
			}

			.tag-header {
				display: flex;
				align-items: baseline;
				gap: 0.75rem;
				margin-bottom: 0.875rem;
			}

			.tag-name {
				font-family: var(--font-display);
				font-size: 1.25rem;
				font-style: italic;
				font-weight: 700;
				color: var(--text);
				text-decoration: none;
				border: none;
				transition: color 0.15s ease;
			}

			.tag-name:hover {
				color: var(--accent);
				border: none;
			}

			.tag-count {
				font-family: var(--font-mono);
				font-size: 0.65rem;
				color: var(--text-light);
				opacity: 0.6;
				letter-spacing: 0.04em;
			}

			.content-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}

			.content-item {
				display: flex;
				align-items: baseline;
				gap: 0.875rem;
				padding: 0.5rem 0;
				border-bottom: 1px solid var(--border);
			}

			.content-item:last-child {
				border-bottom: none;
			}

			.content-type {
				flex-shrink: 0;
				font-family: var(--font-mono);
				font-size: 0.6rem;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: var(--text-light);
				opacity: 0.6;
				min-width: 2.5rem;
			}

			.content-type.blog {
				color: var(--accent);
				opacity: 1;
			}

			.content-type.strava {
				color: #b84a04;
				opacity: 1;
			}

			.content-type.goodreads {
				color: #553b08;
				opacity: 1;
			}

			.content-type.til {
				color: var(--accent-dark);
				opacity: 1;
			}

			.content-link {
				flex: 1;
				font-family: var(--font-body);
				font-size: 0.9375rem;
				color: var(--text);
				text-decoration: none;
				border: none;
				transition: color 0.15s ease;
				line-height: 1.45;
			}

			.content-link:hover {
				color: var(--accent);
				border: none;
			}

			.strava-details {
				color: var(--text-light);
				font-family: var(--font-mono);
				font-size: 0.7rem;
			}

			/* — Timeline — */
			.timeline-section {
				margin-bottom: 4rem;
			}

			.section-label {
				font-family: var(--font-mono);
				font-size: 0.65rem;
				text-transform: uppercase;
				letter-spacing: 0.12em;
				color: var(--text-light);
				margin-bottom: 1.5rem;
				display: flex;
				align-items: center;
				gap: 0.75rem;
				opacity: 0.7;
			}

			.section-label::before {
				content: '';
				display: inline-block;
				width: 1.25rem;
				height: 1px;
				background: var(--accent);
				flex-shrink: 0;
				opacity: 0.6;
			}

			.timeline-group {
				margin-bottom: 0;
				padding: 1.25rem 0;
				border-bottom: 1px solid var(--border);
			}

			.timeline-group:last-child {
				border-bottom: none;
			}

			.timeline-date {
				font-family: var(--font-mono);
				font-size: 0.65rem;
				color: var(--text-light);
				margin-bottom: 0.625rem;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				opacity: 0.65;
			}

			.timeline-items {
				list-style: none;
				padding: 0;
				margin: 0;
			}

			.timeline-items .content-item {
				padding: 0.375rem 0;
			}

			.type-group-wrapper {
				position: relative;
			}

			.condensed-notice {
				padding: 0.375rem 0;
				font-size: 0.8rem;
				display: flex;
				align-items: center;
				gap: 0.5rem;
				color: var(--text-light);
				font-family: var(--font-mono);
			}

			.condensed-tag {
				color: var(--accent);
				text-decoration: none;
				border: none;
			}

			.condensed-tag:hover {
				border-bottom: 1px solid var(--accent);
			}

			.condensed-count {
				color: var(--text-light);
				opacity: 0.6;
			}

			/* — Heatmap — */
			.heatmap-section {
				margin-bottom: 3rem;
				padding-top: 3rem;
				border-top: 1px solid var(--border);
			}

			.heatmap-container {
				padding: 1rem 0;
				max-width: 100%;
			}

			.heatmap-wrapper {
				display: grid;
				grid-template-columns: auto 1fr;
				gap: 0.5rem;
				max-width: 100%;
			}

			.heatmap-days {
				display: grid;
				grid-auto-rows: 12px;
				gap: 3px;
				padding-top: 20px;
				font-size: 0.6rem;
				font-family: var(--font-mono);
				color: var(--text-light);
				text-align: right;
				padding-right: 0.5rem;
				opacity: 0.5;
				letter-spacing: 0.02em;
			}

			.heatmap-main {
				display: flex;
				flex-direction: column;
			}

			.heatmap-months {
				display: grid;
				grid-template-columns: repeat(52, 1fr);
				gap: 3px;
				margin-bottom: 0.25rem;
				font-size: 0.575rem;
				font-family: var(--font-mono);
				color: var(--text-light);
				height: 16px;
				opacity: 0.5;
				letter-spacing: 0.04em;
			}

			.heatmap-month {
				font-size: 0.575rem;
			}

			.heatmap-grid {
				display: grid;
				grid-template-rows: repeat(7, 1fr);
				grid-auto-columns: 1fr;
				gap: 3px;
				grid-auto-flow: column;
				height: calc(7 * 10px + 6 * 3px);
			}

			.heatmap-cell {
				width: 100%;
				height: 100%;
				min-width: 8px;
				min-height: 8px;
				border-radius: 1px;
				background: var(--border);
				cursor: pointer;
				position: relative;
				transition: transform 0.1s ease;
			}

			.heatmap-cell:hover {
				transform: scale(1.2);
				z-index: 10;
			}

			.heatmap-cell[data-intensity="0"] {
				background: var(--border);
				opacity: 0.35;
			}

			.heatmap-cell[data-intensity="1"] { opacity: 0.4; }
			.heatmap-cell[data-intensity="2"] { opacity: 0.6; }
			.heatmap-cell[data-intensity="3"] { opacity: 0.8; }
			.heatmap-cell[data-intensity="4"] { opacity: 1.0; }

			.heatmap-cell[data-tag="mixed"] {
				background: linear-gradient(135deg,
					hsl(210, 55%, 55%) 0%, hsl(210, 55%, 55%) 50%,
					hsl(150, 50%, 50%) 50%, hsl(150, 50%, 50%) 100%);
			}

			.heatmap-tooltip {
				position: fixed;
				background: var(--bg-elevated);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				padding: 0.625rem 0.875rem;
				pointer-events: none;
				z-index: 1000;
				box-shadow: var(--shadow-md);
				display: none;
				max-width: 200px;
			}

			.heatmap-tooltip.visible {
				display: block;
			}

			.tooltip-date {
				font-family: var(--font-mono);
				font-size: 0.65rem;
				font-weight: 500;
				color: var(--text);
				margin-bottom: 0.25rem;
				letter-spacing: 0.04em;
			}

			.tooltip-count {
				font-family: var(--font-mono);
				color: var(--text-light);
				font-size: 0.6rem;
				margin-bottom: 0.375rem;
				opacity: 0.7;
			}

			.tooltip-tags {
				font-family: var(--font-mono);
				color: var(--text);
				font-size: 0.6rem;
				line-height: 1.5;
			}

			.heatmap-legend {
				display: flex;
				gap: 1.25rem;
				margin-top: 0.875rem;
				flex-wrap: wrap;
			}

			.legend-item {
				display: flex;
				align-items: center;
				gap: 0.4rem;
			}

			.legend-item a {
				font-family: var(--font-mono);
				font-size: 0.65rem;
				color: var(--text-light);
				text-decoration: none;
				border: none;
				opacity: 0.7;
				letter-spacing: 0.04em;
				transition: color 0.15s ease, opacity 0.15s ease;
			}

			.legend-item a:hover {
				color: var(--accent);
				opacity: 1;
				border: none;
			}

			.legend-color {
				width: 10px;
				height: 10px;
				border-radius: 1px;
			}

			@media (max-width: 720px) {
				.recent-post {
					grid-template-columns: 1fr;
					gap: 0.375rem;
					padding: 1.25rem 0;
				}

				.recent-post-date {
					padding-top: 0;
				}

				.heatmap-section {
					margin-bottom: 2rem;
					display: flex;
					flex-direction: column;
					align-items: center;
				}

				.heatmap-container {
					padding: 0;
					display: flex;
					flex-direction: column;
					align-items: center;
					width: 100%;
				}

				.heatmap-wrapper {
					display: flex;
					flex-direction: column;
					gap: 0.5rem;
					width: auto;
					align-items: center;
				}

				.heatmap-days {
					display: flex;
					justify-content: space-around;
					gap: 0;
					padding: 0;
					order: 2;
					width: 100%;
				}

				.heatmap-days > div {
					flex: 1;
					text-align: center;
				}

				.heatmap-main {
					order: 1;
					width: auto;
					overflow: visible;
				}

				.heatmap-months {
					display: none;
				}

				.heatmap-grid {
					display: grid;
					grid-template-columns: repeat(7, 10px);
					grid-auto-rows: 10px;
					grid-auto-flow: row;
					gap: 2px;
					width: auto;
					height: auto;
				}

				.heatmap-cell {
					width: 10px;
					height: 10px;
					min-width: 10px;
					min-height: 10px;
				}

				.heatmap-cell:hover {
					transform: scale(1.5);
				}

				.heatmap-legend {
					margin-top: 1rem;
					width: 100%;
				}

				.content-item {
					flex-wrap: wrap;
					gap: 0.375rem;
				}
			}

			@media (min-width: 1024px) {
				.tags-grid {
					grid-template-columns: repeat(2, 1fr);
					gap: 0 3rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main">

			<!-- Identity intro -->
			<div class="intro">
				<p class="intro-line">Ya fuí de todo.</p>
				<p class="intro-sub">palabras, código, y kilómetros desde Uruguay.</p>
			</div>

			<!-- Recent writing -->
			<section class="recent-posts" aria-labelledby="recent-heading">
				<div class="section-label" id="recent-heading">últimas entradas</div>
				{recentPosts.map(post => (
					<div class="recent-post">
						<span class="recent-post-date"><FormattedDate date={post.data.pubDate} /></span>
						<div>
							<a href={`/blog/${post.id}/`} class="recent-post-title">{post.data.title}</a>
							{post.data.description && (
								<p class="recent-post-desc">{post.data.description}</p>
							)}
						</div>
					</div>
				))}
				<a href="/blog/" class="view-all">ver todo →</a>
			</section>

			<!-- Mixed recent feed -->
			<section class="timeline-section" aria-labelledby="timeline-heading">
				<div class="section-label" id="timeline-heading" role="heading" aria-level="2">reciente</div>
				{timeline.map(dateGroup => {
					const startDateObj = new Date(dateGroup.startDate);
					const endDateObj = new Date(dateGroup.endDate);

					let dateLabel: string;
					if (dateGroup.startDate !== dateGroup.endDate) {
						dateLabel = `${startDateObj.toISOString().split('T')[0]} — ${endDateObj.toISOString().split('T')[0]}`;
					} else {
						dateLabel = startDateObj.toISOString().split('T')[0];
					}

					return (
						<div class="timeline-group">
							<div class="timeline-date">{dateLabel}</div>
							{dateGroup.typeGroups.map(typeGroup => {
								const shouldCondense = typeGroup.items.length >= CONDENSE_THRESHOLD;
								const visibleItems = shouldCondense ? typeGroup.items.slice(0, 2) : typeGroup.items;
								const hiddenCount = typeGroup.items.length - visibleItems.length;

								return (
									<div class="type-group-wrapper">
										<ul class="timeline-items">
											{visibleItems.map((item: typeof allContent[0]) => {
												const isStrava = item.type === 'strava';
										const isGoodreads = item.type === 'goodreads';
										const goodreadsLabel = isGoodreads ? (item.data as any).action : '';
												let stravaDetails = '';
												if (isStrava) {
													const distanceKm = (item.data.distance / 1000).toFixed(1);
													const paceMinPerKm = item.data.distance > 0
														? (item.data.movingTime / 60) / (item.data.distance / 1000)
														: 0;
													const paceFormatted = paceMinPerKm > 0
														? `${Math.floor(paceMinPerKm)}:${String(Math.round((paceMinPerKm % 1) * 60)).padStart(2, '0')}`
														: '';
													stravaDetails = ` — ${distanceKm} km${paceFormatted ? ` @ ${paceFormatted}/km` : ''}`;
												}
												return (
													<li class="content-item">
														<span class={`content-type ${item.type}`}>{isGoodreads ? goodreadsLabel : item.type}</span>
														<a href={item.url} class="content-link">
															{item.data.title}{isStrava && <span class="strava-details">{stravaDetails}</span>}
														</a>
													</li>
												);
											})}
										</ul>
										{shouldCondense && (
											<div class="condensed-notice">
												<a href={`/tags/${typeGroup.items[0].data.tags[0]}/`} class="condensed-tag">
													#{typeGroup.items[0].data.tags[0]}
												</a>
												<span class="condensed-count">+{hiddenCount}</span>
											</div>
										)}
									</div>
								);
							})}
						</div>
					);
				})}
			</section>

			<!-- Content by mode -->
			<section class="tags-grid" aria-labelledby="tags-heading">
				<h2 id="tags-heading" class="sr-only">Por modo</h2>
				{sortedTags.map(([tag, items]) => (
					<section class="tag-section">
						<div class="tag-header">
							<a href={`/tags/${tag}/`} class="tag-name">#{tag}</a>
							<span class="tag-count">({items.length})</span>
						</div>
						<ul class="content-list">
							{items.slice(0, 5).map(item => {
								const isStrava = item.type === 'strava';
										const isGoodreads = item.type === 'goodreads';
										const goodreadsLabel = isGoodreads ? (item.data as any).action : '';
								let stravaDetails = '';
								if (isStrava) {
									const distanceKm = (item.data.distance / 1000).toFixed(1);
									const paceMinPerKm = item.data.distance > 0
										? (item.data.movingTime / 60) / (item.data.distance / 1000)
										: 0;
									const paceFormatted = paceMinPerKm > 0
										? `${Math.floor(paceMinPerKm)}:${String(Math.round((paceMinPerKm % 1) * 60)).padStart(2, '0')}`
										: '';
									stravaDetails = ` — ${distanceKm} km${paceFormatted ? ` @ ${paceFormatted}/km` : ''}`;
								}
								return (
									<li class="content-item">
										<span class={`content-type ${item.type}`}>{isGoodreads ? goodreadsLabel : item.type}</span>
										<a href={item.url} class="content-link">
											{item.data.title}{isStrava && <span class="strava-details">{stravaDetails}</span>}
										</a>
									</li>
								);
							})}
						</ul>
					</section>
				))}
			</section>

			<!-- Activity heatmap (demoted) -->
			<section class="heatmap-section" aria-labelledby="activity-heading">
				<div class="section-label" id="activity-heading">actividad — último año</div>
				<div class="heatmap-container">
					<div class="heatmap-wrapper">
						<div class="heatmap-days">
							<div></div>
							<div>Mon</div>
							<div></div>
							<div>Wed</div>
							<div></div>
							<div>Fri</div>
							<div></div>
						</div>
						<div class="heatmap-main">
							<div class="heatmap-months">
								{(() => {
									const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
									const months: { name: string; column: number }[] = [];
									let currentMonth = -1;

									for (let weekIndex = 0; weekIndex < 52; weekIndex++) {
										const dayIndex = weekIndex * 7;
										if (dayIndex < heatmapData.length) {
											const date = new Date(heatmapData[dayIndex].date);
											const month = date.getMonth();
											if (month !== currentMonth) {
												months.push({ name: monthNames[month], column: weekIndex + 1 });
												currentMonth = month;
											}
										}
									}

									return months.map(m => (
										<div class="heatmap-month" style={`grid-column-start: ${m.column}`}>{m.name}</div>
									));
								})()}
							</div>
							<div class="heatmap-grid">
								{heatmapData.map(day => {
									let dominantTag = '';
									let intensity = 0;

									if (day.total === 0) {
										intensity = 0;
									} else {
										let maxCount = 0;
										day.tagCounts.forEach((count, tag) => {
											if (count > maxCount) {
												maxCount = count;
												dominantTag = tag;
											}
										});

										const topTagCounts = Array.from(day.tagCounts.values()).sort((a, b) => b - a);
										const hasMultipleTopTags = topTagCounts.length > 1 && topTagCounts[0] === topTagCounts[1];

										if (hasMultipleTopTags) dominantTag = 'mixed';
										intensity = Math.min(4, day.total);
									}

									let tooltip = day.date;
									if (day.total > 0) {
										const tagList = Array.from(day.tagCounts.entries())
											.sort((a, b) => b[1] - a[1])
											.map(([tag, count]) => `#${tag} (${count})`)
											.join(' • ');
										tooltip = `${day.date}\n${day.total} ${day.total === 1 ? 'item' : 'items'}\n${tagList}`;
									}

									return (
										<div
											class="heatmap-cell"
											data-tag={dominantTag}
											data-intensity={intensity}
											data-date={day.date}
											data-total={day.total}
											data-tags={day.total > 0 ? Array.from(day.tagCounts.entries())
												.sort((a, b) => b[1] - a[1])
												.map(([tag, count]) => `#${tag} (${count})`)
												.join(' • ') : ''}
											title={tooltip}
										></div>
									);
								})}
							</div>
						</div>
					</div>
					<div class="heatmap-legend">
						{topTags.map((tag) => {
							const hue = tagColors.get(tag) || 200;
							return (
								<div class="legend-item">
									<div class="legend-color" style={`background: hsl(${hue}, 70%, 55%)`}></div>
									<a href={`/tags/${tag}/`}>#{tag}</a>
								</div>
							);
						})}
					</div>
				</div>
				<div class="heatmap-tooltip" id="heatmap-tooltip">
					<div class="tooltip-date"></div>
					<div class="tooltip-count"></div>
					<div class="tooltip-tags"></div>
				</div>
			</section>

		</main>
		<Footer />
		<script is:inline define:vars={{ topTags, tagColors: Array.from(tagColors.entries()) }}>
			document.addEventListener('DOMContentLoaded', () => {
				const tagColorMap = new Map(tagColors);
				const cells = document.querySelectorAll('.heatmap-cell[data-tag]');
				const tooltip = document.getElementById('heatmap-tooltip');

				cells.forEach(cell => {
					const tag = cell.getAttribute('data-tag');
					const intensity = cell.getAttribute('data-intensity');

					if (tag && tag !== 'mixed' && intensity !== '0') {
						const hue = tagColorMap.get(tag) || 200;
						cell.style.background = `hsl(${hue}, 70%, 55%)`;
					}

					cell.addEventListener('mouseenter', (e) => {
						const date = cell.getAttribute('data-date');
						const total = parseInt(cell.getAttribute('data-total'));
						const tags = cell.getAttribute('data-tags');

						if (total > 0) {
							tooltip.querySelector('.tooltip-date').textContent = date;
							tooltip.querySelector('.tooltip-count').textContent =
								`${total} ${total === 1 ? 'item' : 'items'}`;
							tooltip.querySelector('.tooltip-tags').textContent = tags;
						} else {
							tooltip.querySelector('.tooltip-date').textContent = date;
							tooltip.querySelector('.tooltip-count').textContent = 'No activity';
							tooltip.querySelector('.tooltip-tags').textContent = '';
						}

						tooltip.classList.add('visible');
						updateTooltipPosition(e);
					});

					cell.addEventListener('mousemove', (e) => {
						updateTooltipPosition(e);
					});

					cell.addEventListener('mouseleave', () => {
						tooltip.classList.remove('visible');
					});

					cell.addEventListener('click', () => {
						const date = cell.getAttribute('data-date');
						const total = parseInt(cell.getAttribute('data-total') || '0');
						if (total > 0 && window.umami) {
							window.umami.track('heatmap-click', { date });
						}
					});
				});

				function updateTooltipPosition(e) {
					const offset = 10;
					const tooltipRect = tooltip.getBoundingClientRect();
					let x = e.clientX + offset;
					let y = e.clientY + offset;

					if (x + tooltipRect.width > window.innerWidth) {
						x = e.clientX - tooltipRect.width - offset;
					}
					if (y + tooltipRect.height > window.innerHeight) {
						y = e.clientY - tooltipRect.height - offset;
					}

					tooltip.style.left = `${x}px`;
					tooltip.style.top = `${y}px`;
				}
			});
		</script>
	</body>
</html>
