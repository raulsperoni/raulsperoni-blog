---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_HOME_TITLE } from '../consts';

const allPosts = await getCollection('blog');
const allLinks = await getCollection('links');
const allStrava = await getCollection('strava');
const allGoodreads = await getCollection('goodreads');
const allTil = await getCollection('til');

const HAGO_TAG = 'hago 🔧';
const newestFirst = (a: { data: { pubDate: Date } }, b: { data: { pubDate: Date } }) =>
	b.data.pubDate.valueOf() - a.data.pubDate.valueOf();

const posts = allPosts.map(p => ({ ...p, type: 'blog' as const, url: `/blog/${p.id}/` }));
const links = allLinks.map(l => ({ ...l, type: 'link' as const, url: `/links/${l.id}/` }));
const tils = allTil.map(t => ({ ...t, type: 'til' as const, url: `/til/${t.id}/` }));
// Goodreads also logs "want to read", follows and other noise: keep only books
// I'm reading or finished, one row per book (its latest state).
const seenBooks = new Set<string>();
const books = [...allGoodreads]
	.sort(newestFirst)
	.filter(b => ['read', 'reading'].includes(b.data.action))
	.filter(b => !seenBooks.has(b.data.bookTitle) && seenBooks.add(b.data.bookTitle))
	.map(b => ({ ...b, type: 'goodreads' as const, url: b.data.goodreadsUrl }));
const workouts = [...allStrava].sort(newestFirst);

// — Featured blocks: professional first —
const recentTil = [...tils].sort(newestFirst).slice(0, 3);
const recentHago = [...posts, ...links]
	.filter(item => item.data.tags.includes(HAGO_TAG))
	.sort(newestFirst)
	.slice(0, 3);
const recentPosts = [...posts].sort(newestFirst).slice(0, 3);

// — Year strip: 52 weeks × three lanes (palabras / código / km) —
const DAY = 86_400_000;
const WEEK = 7 * DAY;
const WEEKS = 52;

const mondayOf = (d: Date) => {
	const t = Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate());
	return t - ((new Date(t).getUTCDay() + 6) % 7) * DAY;
};
const firstMonday = mondayOf(new Date()) - (WEEKS - 1) * WEEK;
const weekOf = (d: Date) => Math.round((mondayOf(d) - firstMonday) / WEEK);
const inStrip = (d: Date) => weekOf(d) >= 0 && weekOf(d) < WEEKS;

interface Cell {
	titles: string[];
	url?: string;
	km: number;
	hours: number;
}
const emptyLane = (): Cell[] =>
	Array.from({ length: WEEKS }, () => ({ titles: [], km: 0, hours: 0 }));

const palabras = emptyLane();
const codigo = emptyLane();
const km = emptyLane();

const mark = (lane: Cell[], item: { data: { pubDate: Date; title: string }; url: string }) => {
	if (!inStrip(item.data.pubDate)) return;
	const cell = lane[weekOf(item.data.pubDate)];
	if (!cell.titles.includes(item.data.title)) cell.titles.push(item.data.title);
	cell.url ??= item.url;
};
// palabras = what I write and read; código = notes and projects.
[...posts, ...books].sort(newestFirst).forEach(item => mark(palabras, item));
[...tils, ...links].sort(newestFirst).forEach(item => mark(codigo, item));
workouts.forEach(w => {
	if (!inStrip(w.data.pubDate)) return;
	const cell = km[weekOf(w.data.pubDate)];
	cell.titles.push(w.data.title);
	cell.km += w.data.distance / 1000;
	cell.hours += w.data.movingTime / 3600;
});

const maxHours = Math.max(...km.map(c => c.hours), 1);
const fmtKm = (n: number) => Math.round(n).toLocaleString('es-UY');
const weekLabel = (i: number) =>
	'semana del ' +
	new Date(firstMonday + i * WEEK).toLocaleDateString('es-UY', {
		day: 'numeric',
		month: 'short',
		timeZone: 'UTC',
	});

const lanes = [
	{
		key: 'palabras',
		label: 'palabras',
		href: '/blog/',
		total: `${palabras.reduce((n, c) => n + c.titles.length, 0)}`,
		cells: palabras.map((c, i) => ({
			level: Math.min(3, c.titles.length),
			url: c.url,
			tip: `${weekLabel(i)}: ${c.titles.join(' · ')}`,
		})),
	},
	{
		key: 'codigo',
		label: 'código',
		href: '/til/',
		total: `${codigo.reduce((n, c) => n + c.titles.length, 0)}`,
		cells: codigo.map((c, i) => ({
			level: Math.min(3, c.titles.length),
			url: c.url,
			tip: `${weekLabel(i)}: ${c.titles.join(' · ')}`,
		})),
	},
	{
		key: 'km',
		label: 'km',
		href: '/fitness/',
		total: fmtKm(km.reduce((n, c) => n + c.km, 0)),
		cells: km.map((c, i) => ({
			level: c.titles.length ? Math.max(1, Math.ceil((c.hours / maxHours) * 3)) : 0,
			url: undefined as string | undefined,
			tip: `${weekLabel(i)}: ${c.titles.length} actividades · ${fmtKm(c.km)} km · ${Math.round(c.hours)} h`,
		})),
	},
];

const MONTHS = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'set', 'oct', 'nov', 'dic'];
const monthLabels: { name: string; column: number }[] = [];
for (let i = 0, last = -1; i < WEEKS; i++) {
	const month = new Date(firstMonday + i * WEEK).getUTCMonth();
	if (month === last) continue;
	last = month;
	// The first column is usually a partial month; skip it so labels don't collide.
	if (i > 0 && i < WEEKS - 1) monthLabels.push({ name: MONTHS[month], column: i + 1 });
}

// — Reciente: everything that isn't training, with the training in between
//   folded into a single line —
const TIMELINE_LIMIT = 10;
const shortDate = (d: Date) =>
	d.toLocaleDateString('en-us', { month: 'short', day: 'numeric', timeZone: 'UTC' });

type TimelineRow =
	| { kind: 'item'; date: Date; label: string; type: string; title: string; url: string }
	| { kind: 'training'; from: Date; to: Date; count: number; km: number };

const timeline: TimelineRow[] = [];
const MIN_TRAINING_LINE = 7; // fewer workouts than this carry over to the next line
let cursor = 0; // index into workouts (newest first)
let between: typeof workouts = [];
for (const item of [...posts, ...links, ...tils, ...books].sort(newestFirst).slice(0, TIMELINE_LIMIT)) {
	while (cursor < workouts.length && workouts[cursor].data.pubDate > item.data.pubDate) {
		between.push(workouts[cursor++]);
	}
	if (between.length >= MIN_TRAINING_LINE) {
		timeline.push({
			kind: 'training',
			from: between[between.length - 1].data.pubDate,
			to: between[0].data.pubDate,
			count: between.length,
			km: between.reduce((n, w) => n + w.data.distance / 1000, 0),
		});
		between = [];
	}
	timeline.push({
		kind: 'item',
		date: item.data.pubDate,
		label: item.type === 'goodreads' ? (item.data.action === 'read' ? 'leí' : 'leyendo') : item.type,
		type: item.type,
		title: item.data.title,
		url: item.url,
	});
}

// Two doors under the intro, one per audience, each in its own language.
const doors = [
	{
		lang: 'en',
		label: 'search · data · applied ai',
		text: 'What I do for a living',
		href: '/cv/',
	},
	{
		lang: 'es',
		label: 'participación · datos abiertos',
		text: 'Lo que hago por fuera',
		href: '/hago/',
	},
];

const blocks = [
	{ id: 'til', label: 'til — notas técnicas', items: recentTil, more: '/til/', lang: 'en' },
	{ id: 'hago', label: 'hago — proyectos', items: recentHago, more: '/hago/', lang: undefined },
	{ id: 'escribo', label: 'escribo — últimas entradas', items: recentPosts, more: '/blog/', lang: undefined },
];
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_HOME_TITLE} description={SITE_DESCRIPTION} />
		<style>
			/* — Intro — */
			.intro {
				padding: 3rem 0 0;
				margin-bottom: 2rem;
			}

			.intro-line {
				font-family: var(--font-display);
				font-size: clamp(1.375rem, 4vw, 1.875rem);
				line-height: 1.25;
				color: var(--text);
				margin: 0 0 1rem;
				letter-spacing: -0.01em;
			}

			.intro-sub {
				font-family: var(--font-mono);
				font-size: 0.65rem;
				color: var(--text-light);
				text-transform: uppercase;
				letter-spacing: 0.1em;
				margin: 0;
				opacity: 0.7;
			}

			/* — Doors — */
			.doors {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1.25rem 3rem;
				margin-top: 2.25rem;
			}

			.door {
				display: flex;
				flex-direction: column;
				gap: 0.3rem;
				text-decoration: none;
				border: none;
				color: var(--text);
			}

			.door-label {
				font-family: var(--font-mono);
				font-size: 0.6rem;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				color: var(--accent);
			}

			.door-text {
				font-family: var(--font-display);
				font-size: 1.25rem;
				font-weight: 700;
				line-height: 1.2;
				transition: color 0.15s ease;
			}

			.door-arrow {
				display: inline-block;
				font-family: var(--font-mono);
				font-weight: 400;
				font-size: 0.9em;
				transition: transform 0.15s ease;
			}

			.door:hover .door-text {
				color: var(--accent);
			}

			.door:hover .door-arrow {
				transform: translateX(4px);
			}

			/* — Year strip — */
			.strip {
				--lane-label: 4.25rem;
				--lane-total: 3.25rem;
				--gap: 2px;
				margin-bottom: 4rem;
				font-family: var(--font-mono);
				font-size: 0.6rem;
				letter-spacing: 0.06em;
				color: var(--text-light);
			}

			.strip-months,
			.lane {
				display: grid;
				grid-template-columns: var(--lane-label) 1fr var(--lane-total);
				align-items: center;
			}

			.strip-months > div,
			.lane-cells {
				grid-column: 2;
				display: grid;
				grid-template-columns: repeat(52, minmax(0, 1fr));
				gap: var(--gap);
			}

			.strip-months span {
				white-space: nowrap;
			}

			.strip-months {
				height: 1rem;
				opacity: 0.55;
				font-size: 0.55rem;
			}

			.lane {
				margin-top: var(--gap);
			}

			.lane-label {
				color: inherit;
				text-decoration: none;
				border: none;
				opacity: 0.75;
				transition: color 0.15s ease, opacity 0.15s ease;
			}

			.lane-label:hover {
				color: var(--lane);
				opacity: 1;
			}

			.lane-total {
				text-align: right;
				opacity: 0.55;
			}

			.cell {
				display: block;
				height: 12px;
				border: none;
				border-radius: 1px;
				background: var(--border);
				opacity: 0.45;
			}

			.lane-palabras { --lane: var(--accent); }
			.lane-codigo { --lane: #1f4e5f; }
			.lane-km { --lane: #b07a10; }

			.cell[data-level='1'] { background: var(--lane); opacity: 0.4; }
			.cell[data-level='2'] { background: var(--lane); opacity: 0.7; }
			.cell[data-level='3'] { background: var(--lane); opacity: 1; }

			a.cell {
				transition: transform 0.1s ease;
			}

			a.cell:hover,
			a.cell:focus-visible {
				transform: scaleY(1.5);
				opacity: 1;
			}

			/* — Featured blocks — */
			.block {
				margin-bottom: 3.5rem;
			}

			.section-label {
				font-family: var(--font-mono);
				font-size: 0.65rem;
				font-weight: 400;
				text-transform: uppercase;
				letter-spacing: 0.12em;
				color: var(--text-light);
				margin: 0 0 0.5rem;
				display: flex;
				align-items: center;
				gap: 0.75rem;
				opacity: 0.7;
			}

			.section-label::before {
				content: '';
				display: inline-block;
				width: 1.25rem;
				height: 1px;
				background: var(--accent);
				flex-shrink: 0;
				opacity: 0.6;
			}

			.entry {
				display: grid;
				grid-template-columns: 6rem 1fr;
				gap: 0 2rem;
				padding: 1.25rem 0;
				border-bottom: 1px solid var(--border);
				align-items: start;
			}

			.entry-date {
				font-family: var(--font-mono);
				font-size: 0.6rem;
				color: var(--text-light);
				text-transform: uppercase;
				letter-spacing: 0.06em;
				padding-top: 0.35rem;
				opacity: 0.65;
			}

			.entry-title {
				font-family: var(--font-display);
				font-size: 1.25rem;
				font-weight: 700;
				line-height: 1.2;
				color: var(--text);
				text-decoration: none;
				border: none;
				display: block;
				overflow-wrap: break-word;
				transition: color 0.15s ease;
			}

			.entry-title:hover {
				color: var(--accent);
			}

			.entry-desc {
				font-family: var(--font-body);
				font-size: 0.9rem;
				color: var(--text-light);
				line-height: 1.55;
				margin: 0.35rem 0 0;
				overflow-wrap: break-word;
			}

			.view-all {
				display: inline-block;
				margin-top: 1rem;
				font-family: var(--font-mono);
				font-size: 0.65rem;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: var(--text-light);
				text-decoration: none;
				border: none;
				opacity: 0.6;
				transition: opacity 0.15s ease, color 0.15s ease;
			}

			.view-all:hover {
				opacity: 1;
				color: var(--accent);
			}

			/* — Reciente — */
			.timeline {
				list-style: none;
				padding: 0;
				margin: 0;
			}

			.timeline-row {
				display: grid;
				grid-template-columns: 6rem 3.5rem 1fr;
				gap: 0 1rem;
				align-items: baseline;
				padding: 0.5rem 0;
				border-bottom: 1px solid var(--border);
			}

			.timeline-row:last-child {
				border-bottom: none;
			}

			.timeline-date,
			.timeline-type {
				font-family: var(--font-mono);
				font-size: 0.6rem;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				color: var(--text-light);
				opacity: 0.65;
			}

			.timeline-type.blog { color: var(--accent); opacity: 1; }
			.timeline-type.til { color: #1f4e5f; opacity: 1; }
			.timeline-type.link { color: #1f4e5f; opacity: 1; }
			.timeline-type.goodreads { color: #553b08; opacity: 1; }
			.timeline-type.training { color: #b07a10; opacity: 1; }

			.timeline-link {
				font-family: var(--font-body);
				font-size: 0.9375rem;
				line-height: 1.45;
				color: var(--text);
				text-decoration: none;
				border: none;
				transition: color 0.15s ease;
			}

			.timeline-link:hover {
				color: var(--accent);
			}

			.timeline-row.is-training .timeline-link {
				font-family: var(--font-mono);
				font-size: 0.7rem;
				color: var(--text-light);
			}

			@media (max-width: 720px) {
				.strip {
					--lane-label: 3.75rem;
					--lane-total: 0px;
					--gap: 1px;
				}

				.lane-total {
					display: none;
				}

				.doors {
					grid-template-columns: 1fr;
				}

				.strip-months span:nth-child(even) {
					display: none;
				}

				.entry {
					grid-template-columns: 1fr;
					gap: 0.375rem;
				}

				.entry-date {
					padding-top: 0;
				}

				.timeline-row {
					grid-template-columns: auto 1fr;
					gap: 0.125rem 0.75rem;
				}

				.timeline-link {
					grid-column: 1 / -1;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main">

			<!-- Identity intro -->
			<div class="intro">
				<p class="intro-line">Ya fui de todo.</p>
				<p class="intro-sub">palabras, código, y kilómetros desde Uruguay.</p>
				<nav class="doors" aria-label="Por dónde empezar">
					{doors.map(door => (
						<a class="door" href={door.href} lang={door.lang}>
							<span class="door-label">{door.label}</span>
							<span class="door-text">{door.text} <span class="door-arrow" aria-hidden="true">→</span></span>
						</a>
					))}
				</nav>
			</div>

			<!-- A year in three lanes, one column per week. Rendered at build time. -->
			<div class="strip" aria-label="El último año, semana a semana">
				<div class="strip-months" aria-hidden="true">
					<div>
						{monthLabels.map(m => (
							<span style={`grid-column-start: ${m.column}`}>{m.name}</span>
						))}
					</div>
				</div>
				{lanes.map(lane => (
					<div class={`lane lane-${lane.key}`}>
						<a class="lane-label" href={lane.href}>{lane.label}</a>
						<div class="lane-cells">
							{lane.cells.map(cell =>
								cell.level === 0 ? (
									<span class="cell" />
								) : cell.url ? (
									<a class="cell" href={cell.url} data-level={cell.level} title={cell.tip} aria-label={cell.tip} />
								) : (
									<span class="cell" data-level={cell.level} title={cell.tip} />
								)
							)}
						</div>
						<span class="lane-total">{lane.total}</span>
					</div>
				))}
			</div>

			{blocks.map(block => (
				<section class="block" aria-labelledby={`${block.id}-heading`}>
					<h2 class="section-label" id={`${block.id}-heading`}>{block.label}</h2>
					{block.items.map(item => (
						<div class="entry" lang={block.lang}>
							<span class="entry-date"><FormattedDate date={item.data.pubDate} /></span>
							<div>
								<a href={item.url} class="entry-title">{item.data.title}</a>
								{item.data.description && <p class="entry-desc">{item.data.description}</p>}
							</div>
						</div>
					))}
					<a href={block.more} class="view-all">ver todo →</a>
				</section>
			))}

			<!-- Mixed recent feed -->
			<section class="block" aria-labelledby="timeline-heading">
				<h2 class="section-label" id="timeline-heading">reciente</h2>
				<ul class="timeline">
					{timeline.map(row =>
						row.kind === 'training' ? (
							<li class="timeline-row is-training">
								<span class="timeline-date">
									{shortDate(row.from)} – {shortDate(row.to)}
								</span>
								<span class="timeline-type training">entreno</span>
								<a href="/fitness/" class="timeline-link">
									{row.count} actividades · {fmtKm(row.km)} km
								</a>
							</li>
						) : (
							<li class="timeline-row">
								<span class="timeline-date">{shortDate(row.date)}</span>
								<span class={`timeline-type ${row.type}`}>{row.label}</span>
								<a href={row.url} class="timeline-link">{row.title}</a>
							</li>
						)
					)}
				</ul>
			</section>

		</main>
		<Footer />
	</body>
</html>
