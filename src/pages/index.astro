---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const allPosts = await getCollection('blog');
const allLinks = await getCollection('links');
const allStrava = await getCollection('strava');

const allContent = [
	...allPosts.map(post => ({
		...post,
		type: 'blog' as const,
		url: `/blog/${post.id}/`
	})),
	...allLinks.map(link => ({
		...link,
		type: 'link' as const,
		url: `/links/${link.id}/`
	})),
	...allStrava.map(activity => ({
		...activity,
		type: 'strava' as const,
		url: activity.data.stravaUrl
	}))
].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const tagMap = new Map<string, typeof allContent>();

allContent.forEach(item => {
	item.data.tags.forEach(tag => {
		if (!tagMap.has(tag)) {
			tagMap.set(tag, []);
		}
		tagMap.get(tag)!.push(item);
	});
});

const sortedTags = Array.from(tagMap.entries())
	.sort((a, b) => b[1].length - a[1].length);

// Timeline: Group by date first, then merge consecutive same-type dates
interface TimelineGroup {
	startDate: string;
	endDate: string;
	typeGroups: {
		type: string;
		items: typeof allContent;
	}[];
}

const TIMELINE_LIMIT = 30;
const CONDENSE_THRESHOLD = 3;

// Heatmap: Build activity calendar for the past year
interface HeatmapDay {
	date: string;
	blog: number;
	link: number;
	strava: number;
	total: number;
}

const heatmapData: HeatmapDay[] = [];
const now = new Date();
const oneYearAgo = new Date(now);
oneYearAgo.setFullYear(now.getFullYear() - 1);

// Create map of date -> counts
const activityMap = new Map<string, { blog: number; link: number; strava: number }>();

allContent.forEach(item => {
	const dateKey = item.data.pubDate.toISOString().split('T')[0];
	const itemDate = new Date(dateKey);

	if (itemDate >= oneYearAgo && itemDate <= now) {
		if (!activityMap.has(dateKey)) {
			activityMap.set(dateKey, { blog: 0, link: 0, strava: 0 });
		}
		const counts = activityMap.get(dateKey)!;
		counts[item.type]++;
	}
});

// Generate exactly 52 weeks of data (364 days = 52 weeks * 7 days)
const startDate = new Date(now);
startDate.setDate(now.getDate() - 363); // 363 days ago + today = 364 days total

for (let i = 0; i < 364; i++) {
	const date = new Date(startDate);
	date.setDate(startDate.getDate() + i);
	const dateKey = date.toISOString().split('T')[0];

	const counts = activityMap.get(dateKey) || { blog: 0, link: 0, strava: 0 };
	heatmapData.push({
		date: dateKey,
		blog: counts.blog,
		link: counts.link,
		strava: counts.strava,
		total: counts.blog + counts.link + counts.strava,
	});
}

// Calculate max for color intensity
const maxTotal = Math.max(...heatmapData.map(d => d.total), 1);

// Group by date
const dateGroups = new Map<string, typeof allContent>();
for (let i = 0; i < Math.min(allContent.length, TIMELINE_LIMIT); i++) {
	const item = allContent[i];
	const dateKey = item.data.pubDate.toISOString().split('T')[0];

	if (!dateGroups.has(dateKey)) {
		dateGroups.set(dateKey, []);
	}
	dateGroups.get(dateKey)!.push(item);
}

// Convert to array and sort by date (newest first)
const sortedDates = Array.from(dateGroups.entries()).sort((a, b) =>
	new Date(b[0]).getTime() - new Date(a[0]).getTime()
);

// Build timeline with type grouping per date
const timeline: TimelineGroup[] = [];
for (const [date, items] of sortedDates) {
	const typeGroups: { type: string; items: typeof allContent }[] = [];

	for (const item of items) {
		const lastGroup = typeGroups[typeGroups.length - 1];

		if (lastGroup && lastGroup.type === item.type) {
			lastGroup.items.push(item);
		} else {
			typeGroups.push({
				type: item.type,
				items: [item],
			});
		}
	}

	// Check if we can merge with the previous timeline group
	const lastTimelineGroup = timeline[timeline.length - 1];
	const isSingleType = typeGroups.length === 1;
	const lastIsSingleType = lastTimelineGroup && lastTimelineGroup.typeGroups.length === 1;

	if (lastTimelineGroup && isSingleType && lastIsSingleType &&
		typeGroups[0].type === lastTimelineGroup.typeGroups[0].type) {
		// Merge into existing group
		lastTimelineGroup.endDate = date;
		lastTimelineGroup.typeGroups[0].items.push(...typeGroups[0].items);
	} else {
		// Create new group
		timeline.push({
			startDate: date,
			endDate: date,
			typeGroups
		});
	}
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.tags-grid {
				display: grid;
				grid-template-columns: 1fr;
				gap: 2rem;
				margin-bottom: 4rem;
			}

			.tag-section {
				background: var(--bg-elevated);
				padding: 1.5rem;
				border-radius: 8px;
				border: 1px solid var(--border);
			}

			.tag-header {
				display: flex;
				align-items: baseline;
				gap: 0.75rem;
				margin-bottom: 1rem;
				padding-bottom: 0.75rem;
				border-bottom: 1px solid var(--border);
			}

			.tag-name {
				font-size: 1.25rem;
				font-weight: 600;
				color: var(--text);
				text-decoration: none;
				border: none;
				letter-spacing: -0.02em;
			}

			.tag-name:hover {
				color: var(--accent);
				border: none;
			}

			.tag-count {
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
				font-size: 0.8125rem;
				color: var(--text-light);
			}

			.content-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}

			.content-item {
				display: flex;
				align-items: baseline;
				gap: 0.75rem;
				padding: 0.625rem 0;
				border-bottom: 1px solid var(--border);
			}

			.content-item:last-child {
				border-bottom: none;
			}

			.content-type {
				flex-shrink: 0;
				padding: 0.25rem 0.5rem;
				background: var(--accent-light);
				color: var(--accent-dark);
				border-radius: 3px;
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
				font-size: 0.6875rem;
				text-transform: uppercase;
				font-weight: 600;
				letter-spacing: 0.05em;
			}

			.content-type.blog {
				background: var(--accent);
				color: white;
			}

			.content-type.strava {
				background: #fc4c02;
				color: white;
			}

			.content-link {
				flex: 1;
				color: var(--text);
				text-decoration: none;
				font-size: 1rem;
				border: none;
				transition: color 0.2s ease;
			}

			.content-link:hover {
				color: var(--accent);
				border: none;
			}

			.strava-details {
				color: var(--text-light);
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
				font-size: 0.875rem;
				font-weight: 400;
			}

			.timeline-section {
				margin-bottom: 4rem;
			}

			.timeline-section h2 {
				font-size: 1.5rem;
				font-weight: 600;
				margin-bottom: 1.5rem;
				padding-bottom: 0.75rem;
				border-bottom: 1px solid var(--border);
			}

			.timeline-group {
				margin-bottom: 2.5rem;
				position: relative;
				padding-left: 2rem;
			}

			.timeline-group::before {
				content: '';
				position: absolute;
				left: 0.5rem;
				top: 2rem;
				bottom: 0;
				width: 2px;
				background: var(--border);
			}

			.timeline-date {
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
				font-size: 0.875rem;
				font-weight: 600;
				color: var(--text-light);
				margin-bottom: 0.75rem;
				margin-left: -2rem;
				padding-left: 2rem;
			}

			.timeline-items {
				list-style: none;
				padding: 0;
				margin: 0 0 0.5rem 0;
			}

			.timeline-items .content-item {
				position: relative;
				padding-left: 1.5rem;
			}

			.timeline-items .content-item::before {
				content: '';
				position: absolute;
				left: -1.8rem;
				top: 0.75rem;
				width: 8px;
				height: 8px;
				border-radius: 50%;
				background: var(--accent);
				border: 2px solid var(--bg);
				z-index: 1;
			}

			.type-group-wrapper {
				position: relative;
			}

			.condensed-notice {
				padding: 0.5rem 0;
				margin: 0.5rem 0 0.75rem 1.5rem;
				font-size: 0.875rem;
				display: flex;
				align-items: center;
				gap: 0.5rem;
				color: var(--text-light);
			}

			.condensed-tag {
				color: var(--accent);
				text-decoration: none;
				font-weight: 500;
			}

			.condensed-tag:hover {
				text-decoration: underline;
			}

			.condensed-count {
				color: var(--text-light);
			}

			/* Heatmap styles */
			.heatmap-section {
				margin-bottom: 3rem;
			}

			.heatmap-container {
				padding: 1rem 0;
				max-width: 100%;
			}

			.heatmap-wrapper {
				display: grid;
				grid-template-columns: auto 1fr;
				gap: 0.5rem;
				max-width: 100%;
			}

			.heatmap-days {
				display: grid;
				grid-auto-rows: 12px;
				gap: 3px;
				padding-top: 20px;
				font-size: 0.625rem;
				color: var(--text-light);
				text-align: right;
				padding-right: 0.5rem;
			}

			.heatmap-main {
				display: flex;
				flex-direction: column;
			}

			.heatmap-months {
				display: grid;
				grid-template-columns: repeat(52, 1fr);
				gap: 3px;
				margin-bottom: 0.25rem;
				font-size: 0.625rem;
				color: var(--text-light);
				height: 16px;
			}

			.heatmap-month {
				font-size: 0.625rem;
			}

			.heatmap-grid {
				display: grid;
				grid-template-rows: repeat(7, 1fr);
				grid-auto-columns: 1fr;
				gap: 3px;
				grid-auto-flow: column;
				height: calc(7 * 10px + 6 * 3px);
			}

			.heatmap-cell {
				width: 100%;
				height: 100%;
				min-width: 8px;
				min-height: 8px;
				border-radius: 2px;
				background: var(--bg-elevated);
				border: 1px solid var(--border);
			}

			.heatmap-cell[data-intensity="0"] {
				background: var(--bg-elevated);
				opacity: 0.3;
			}

			.heatmap-cell[data-type="blog"][data-intensity="1"] { background: hsl(210, 70%, 85%); }
			.heatmap-cell[data-type="blog"][data-intensity="2"] { background: hsl(210, 70%, 70%); }
			.heatmap-cell[data-type="blog"][data-intensity="3"] { background: hsl(210, 70%, 55%); }
			.heatmap-cell[data-type="blog"][data-intensity="4"] { background: hsl(210, 70%, 40%); }

			.heatmap-cell[data-type="strava"][data-intensity="1"] { background: hsl(20, 90%, 85%); }
			.heatmap-cell[data-type="strava"][data-intensity="2"] { background: hsl(20, 90%, 70%); }
			.heatmap-cell[data-type="strava"][data-intensity="3"] { background: hsl(20, 90%, 55%); }
			.heatmap-cell[data-type="strava"][data-intensity="4"] { background: hsl(20, 90%, 40%); }

			.heatmap-cell[data-type="link"][data-intensity="1"] { background: hsl(150, 60%, 85%); }
			.heatmap-cell[data-type="link"][data-intensity="2"] { background: hsl(150, 60%, 70%); }
			.heatmap-cell[data-type="link"][data-intensity="3"] { background: hsl(150, 60%, 55%); }
			.heatmap-cell[data-type="link"][data-intensity="4"] { background: hsl(150, 60%, 40%); }

			.heatmap-cell[data-type="mixed"] {
				background: linear-gradient(135deg,
					hsl(210, 70%, 60%) 0%, hsl(210, 70%, 60%) 33%,
					hsl(20, 90%, 60%) 33%, hsl(20, 90%, 60%) 66%,
					hsl(150, 60%, 60%) 66%, hsl(150, 60%, 60%) 100%);
			}

			.heatmap-legend {
				display: flex;
				gap: 1.5rem;
				margin-top: 1rem;
				font-size: 0.75rem;
				color: var(--text-light);
				flex-wrap: wrap;
			}

			.legend-item {
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}

			.legend-color {
				width: 12px;
				height: 12px;
				border-radius: 2px;
			}

			.legend-color.blog { background: hsl(210, 70%, 55%); }
			.legend-color.strava { background: hsl(20, 90%, 55%); }
			.legend-color.link { background: hsl(150, 60%, 55%); }

			@media (min-width: 1024px) {
				.tags-grid {
					grid-template-columns: repeat(2, 1fr);
				}
			}

			@media (max-width: 720px) {
				.content-item {
					flex-direction: column;
					gap: 0.5rem;
				}

				.tag-section {
					padding: 1rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="heatmap-section">
				<div class="heatmap-container">
					<div class="heatmap-wrapper">
						<div class="heatmap-days">
							<div></div>
							<div>Mon</div>
							<div></div>
							<div>Wed</div>
							<div></div>
							<div>Fri</div>
							<div></div>
						</div>
						<div class="heatmap-main">
							<div class="heatmap-months">
								{(() => {
									const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
									const months: { name: string; column: number }[] = [];
									let currentMonth = -1;

									for (let weekIndex = 0; weekIndex < 52; weekIndex++) {
										const dayIndex = weekIndex * 7;
										if (dayIndex < heatmapData.length) {
											const date = new Date(heatmapData[dayIndex].date);
											const month = date.getMonth();
											if (month !== currentMonth) {
												months.push({ name: monthNames[month], column: weekIndex + 1 });
												currentMonth = month;
											}
										}
									}

									return months.map(m => (
										<div class="heatmap-month" style={`grid-column-start: ${m.column}`}>{m.name}</div>
									));
								})()}
							</div>
							<div class="heatmap-grid">
						{heatmapData.map(day => {
							// Determine dominant type and intensity
							let dominantType = 'blog';
							let intensity = 0;

							if (day.total === 0) {
								intensity = 0;
							} else if (day.blog > 0 && day.link > 0 && day.strava > 0) {
								dominantType = 'mixed';
								intensity = Math.min(4, day.total);
							} else if (day.blog > day.link && day.blog > day.strava) {
								dominantType = 'blog';
								intensity = Math.min(4, day.blog);
							} else if (day.strava > day.blog && day.strava > day.link) {
								dominantType = 'strava';
								intensity = Math.min(4, day.strava);
							} else if (day.link > 0) {
								dominantType = 'link';
								intensity = Math.min(4, day.link);
							} else if (day.blog > 0) {
								dominantType = 'blog';
								intensity = Math.min(4, day.blog);
							} else if (day.strava > 0) {
								dominantType = 'strava';
								intensity = Math.min(4, day.strava);
							}

							return (
								<div
									class="heatmap-cell"
									data-type={dominantType}
									data-intensity={intensity}
									title={`${day.date}: ${day.total} ${day.total === 1 ? 'item' : 'items'} (Blog: ${day.blog}, Strava: ${day.strava}, Links: ${day.link})`}
								></div>
							);
						})}
						</div>
					</div>
				</div>
				<div class="heatmap-legend">
						<div class="legend-item">
							<div class="legend-color blog"></div>
							<span>Blog posts</span>
						</div>
						<div class="legend-item">
							<div class="legend-color strava"></div>
							<span>Strava activities</span>
						</div>
						<div class="legend-item">
							<div class="legend-color link"></div>
							<span>Links</span>
						</div>
					</div>
				</div>
			</section>

			<section class="timeline-section">
				{timeline.map(dateGroup => {
					const startDateObj = new Date(dateGroup.startDate);
					const endDateObj = new Date(dateGroup.endDate);
					const now = new Date();
					const startDiffTime = now.getTime() - startDateObj.getTime();
					const startDiffDays = Math.floor(startDiffTime / (1000 * 60 * 60 * 24));
					const endDiffTime = now.getTime() - endDateObj.getTime();
					const endDiffDays = Math.floor(endDiffTime / (1000 * 60 * 60 * 24));

					let dateLabel: string;
					// If date range spans multiple days, show range
					if (dateGroup.startDate !== dateGroup.endDate) {
						const formatDayLabel = (diffDays: number) => {
							if (diffDays === 0) return 'Today';
							if (diffDays === 1) return 'Yesterday';
							if (diffDays < 7) return `${diffDays} days ago`;
							if (diffDays < 14) return '1 week ago';
							if (diffDays < 30) return `${Math.floor(diffDays / 7)} weeks ago`;
							if (diffDays < 60) return '1 month ago';
							return `${Math.floor(diffDays / 30)} months ago`;
						};
						dateLabel = `${formatDayLabel(startDiffDays)} - ${formatDayLabel(endDiffDays)}`;
					} else {
						// Single day
						if (startDiffDays === 0) {
							dateLabel = 'Today';
						} else if (startDiffDays === 1) {
							dateLabel = 'Yesterday';
						} else if (startDiffDays < 7) {
							dateLabel = `${startDiffDays} days ago`;
						} else if (startDiffDays < 14) {
							dateLabel = '1 week ago';
						} else if (startDiffDays < 30) {
							dateLabel = `${Math.floor(startDiffDays / 7)} weeks ago`;
						} else if (startDiffDays < 60) {
							dateLabel = '1 month ago';
						} else {
							dateLabel = `${Math.floor(startDiffDays / 30)} months ago`;
						}
					}

					return (
						<div class="timeline-group">
							<div class="timeline-date">{dateLabel}</div>
							{dateGroup.typeGroups.map(typeGroup => {
								const shouldCondense = typeGroup.items.length >= CONDENSE_THRESHOLD;
								const visibleItems = shouldCondense ? typeGroup.items.slice(0, 2) : typeGroup.items;
								const hiddenCount = typeGroup.items.length - visibleItems.length;

								return (
									<div class="type-group-wrapper">
										<ul class="timeline-items">
											{visibleItems.map((item: typeof allContent[0]) => {
												const isStrava = item.type === 'strava';
												let stravaDetails = '';
												if (isStrava) {
													const distanceKm = (item.data.distance / 1000).toFixed(1);
													const paceMinPerKm = item.data.distance > 0
														? (item.data.movingTime / 60) / (item.data.distance / 1000)
														: 0;
													const paceFormatted = paceMinPerKm > 0
														? `${Math.floor(paceMinPerKm)}:${String(Math.round((paceMinPerKm % 1) * 60)).padStart(2, '0')}`
														: '';
													stravaDetails = ` — ${distanceKm} km${paceFormatted ? ` @ ${paceFormatted}/km` : ''}`;
												}
												return (
													<li class="content-item">
														<span class={`content-type ${item.type}`}>{item.type}</span>
														<a href={item.url} class="content-link">
															{item.data.title}{isStrava && <span class="strava-details">{stravaDetails}</span>}
														</a>
													</li>
												);
											})}
										</ul>
										{shouldCondense && (
											<div class="condensed-notice">
												<a href={`/tags/${typeGroup.items[0].data.tags[0]}/`} class="condensed-tag">
													#{typeGroup.items[0].data.tags[0]}
												</a>
												<span class="condensed-count">+{hiddenCount}</span>
											</div>
										)}
									</div>
								);
							})}
						</div>
					);
				})}
			</section>

			<div class="tags-grid">
				{sortedTags.map(([tag, items]) => (
					<section class="tag-section">
						<div class="tag-header">
							<a href={`/tags/${tag}/`} class="tag-name">#{tag}</a>
							<span class="tag-count">({items.length})</span>
						</div>
						<ul class="content-list">
							{items.slice(0, 5).map(item => {
								const isStrava = item.type === 'strava';
								let stravaDetails = '';
								if (isStrava) {
									const distanceKm = (item.data.distance / 1000).toFixed(1);
									const paceMinPerKm = item.data.distance > 0
										? (item.data.movingTime / 60) / (item.data.distance / 1000)
										: 0;
									const paceFormatted = paceMinPerKm > 0
										? `${Math.floor(paceMinPerKm)}:${String(Math.round((paceMinPerKm % 1) * 60)).padStart(2, '0')}`
										: '';
									stravaDetails = ` — ${distanceKm} km${paceFormatted ? ` @ ${paceFormatted}/km` : ''}`;
								}
								return (
									<li class="content-item">
										<span class={`content-type ${item.type}`}>{item.type}</span>
										<a href={item.url} class="content-link">
											{item.data.title}{isStrava && <span class="strava-details">{stravaDetails}</span>}
										</a>
									</li>
								);
							})}
						</ul>
					</section>
				))}
			</div>
		</main>
		<Footer />
	</body>
</html>
