---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const allPosts = await getCollection('blog');
const allLinks = await getCollection('links');

const allContent = [
	...allPosts.map(post => ({
		...post,
		type: 'blog' as const,
		url: `/blog/${post.id}/`
	})),
	...allLinks.map(link => ({
		...link,
		type: 'link' as const,
		url: `/links/${link.id}/`
	}))
].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const tagMap = new Map<string, typeof allContent>();

allContent.forEach(item => {
	item.data.tags.forEach(tag => {
		if (!tagMap.has(tag)) {
			tagMap.set(tag, []);
		}
		tagMap.get(tag)!.push(item);
	});
});

const sortedTags = Array.from(tagMap.entries())
	.sort((a, b) => b[1].length - a[1].length);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.tag-section {
				margin-bottom: 4rem;
			}

			.tag-header {
				display: flex;
				align-items: baseline;
				gap: 0.75rem;
				margin-bottom: 1.5rem;
				padding-bottom: 0.75rem;
				border-bottom: 1px solid var(--border);
			}

			.tag-name {
				font-size: 1.5rem;
				font-weight: 600;
				color: var(--text);
				text-decoration: none;
				border: none;
				letter-spacing: -0.02em;
			}

			.tag-name:hover {
				color: var(--accent);
				border: none;
			}

			.tag-count {
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
				font-size: 0.875rem;
				color: var(--text-light);
			}

			.content-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}

			.content-item {
				display: flex;
				align-items: baseline;
				gap: 1rem;
				padding: 0.75rem 0;
				border-bottom: 1px solid var(--border);
			}

			.content-item:last-child {
				border-bottom: none;
			}

			.content-type {
				flex-shrink: 0;
				padding: 0.25rem 0.5rem;
				background: var(--accent-light);
				color: var(--accent-dark);
				border-radius: 3px;
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
				font-size: 0.6875rem;
				text-transform: uppercase;
				font-weight: 600;
				letter-spacing: 0.05em;
			}

			.content-type.blog {
				background: var(--accent);
				color: white;
			}

			.content-link {
				flex: 1;
				color: var(--text);
				text-decoration: none;
				font-size: 1rem;
				border: none;
				transition: color 0.2s ease;
			}

			.content-link:hover {
				color: var(--accent);
				border: none;
			}

			@media (max-width: 720px) {
				.content-item {
					flex-direction: column;
					gap: 0.5rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			{sortedTags.map(([tag, items]) => (
				<section class="tag-section">
					<div class="tag-header">
						<a href={`/tags/${tag}/`} class="tag-name">#{tag}</a>
						<span class="tag-count">({items.length})</span>
					</div>
					<ul class="content-list">
						{items.slice(0, 5).map(item => (
							<li class="content-item">
								<span class={`content-type ${item.type}`}>{item.type}</span>
								<a href={item.url} class="content-link">
									{item.data.title}
								</a>
							</li>
						))}
					</ul>
				</section>
			))}
		</main>
		<Footer />
	</body>
</html>
