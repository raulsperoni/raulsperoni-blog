---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const allPosts = await getCollection('blog');
const allLinks = await getCollection('links');

const allContent = [
	...allPosts.map(post => ({
		...post,
		type: 'blog' as const,
		url: `/blog/${post.id}/`
	})),
	...allLinks.map(link => ({
		...link,
		type: 'link' as const,
		url: `/links/${link.id}/`
	}))
].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const tagMap = new Map<string, typeof allContent>();

allContent.forEach(item => {
	item.data.tags.forEach(tag => {
		if (!tagMap.has(tag)) {
			tagMap.set(tag, []);
		}
		tagMap.get(tag)!.push(item);
	});
});

const sortedTags = Array.from(tagMap.entries())
	.sort((a, b) => b[1].length - a[1].length);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			.tag-section {
				margin-bottom: 3rem;
			}
			.tag-header {
				display: flex;
				align-items: baseline;
				gap: 1rem;
				margin-bottom: 1rem;
				padding-bottom: 0.5rem;
				border-bottom: 2px solid rgb(var(--gray-light));
			}
			.tag-name {
				font-size: 1.5rem;
				font-weight: bold;
				color: rgb(var(--black));
				text-decoration: none;
			}
			.tag-name:hover {
				color: rgb(var(--accent));
			}
			.tag-count {
				font-size: 1rem;
				color: rgb(var(--gray));
			}
			.content-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.content-item {
				display: flex;
				align-items: baseline;
				gap: 1rem;
				padding: 0.5rem 0;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.content-item:last-child {
				border-bottom: none;
			}
			.content-type {
				flex-shrink: 0;
				padding: 0.125rem 0.5rem;
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
				border-radius: 0.25rem;
				font-size: 0.75rem;
				text-transform: uppercase;
				font-weight: 500;
			}
			.content-type.blog {
				background: rgb(var(--accent));
				color: white;
			}
			.content-link {
				flex: 1;
				color: rgb(var(--black));
				text-decoration: none;
				font-size: 1rem;
			}
			.content-link:hover {
				color: rgb(var(--accent));
			}
			@media (max-width: 720px) {
				.content-item {
					flex-direction: column;
					gap: 0.25rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			{sortedTags.map(([tag, items]) => (
				<section class="tag-section">
					<div class="tag-header">
						<a href={`/tags/${tag}/`} class="tag-name">#{tag}</a>
						<span class="tag-count">({items.length})</span>
					</div>
					<ul class="content-list">
						{items.slice(0, 5).map(item => (
							<li class="content-item">
								<span class={`content-type ${item.type}`}>{item.type}</span>
								<a href={item.url} class="content-link">
									{item.data.title}
								</a>
							</li>
						))}
					</ul>
				</section>
			))}
		</main>
		<Footer />
	</body>
</html>
