---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const links = (await getCollection('links')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Links | ${SITE_TITLE}`} description="Interesting links and bookmarks" />
		<style>
			main {
				width: 960px;
			}
			ul {
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			.link-card {
				display: flex;
				gap: 1rem;
				padding: 1rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				transition: 0.2s ease;
			}
			.link-card:hover {
				border-color: rgb(var(--accent));
				box-shadow: var(--box-shadow);
			}
			.link-favicon {
				width: 24px;
				height: 24px;
				flex-shrink: 0;
			}
			.link-content {
				flex: 1;
			}
			.link-header {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				margin-bottom: 0.5rem;
			}
			.link-title {
				margin: 0;
				color: rgb(var(--black));
				font-size: 1.2rem;
			}
			.link-url {
				color: rgb(var(--gray));
				font-size: 0.9rem;
				text-decoration: none;
			}
			.link-url:hover {
				color: rgb(var(--accent));
			}
			.link-description {
				margin: 0.5rem 0;
				color: rgb(var(--gray-dark));
			}
			.link-meta {
				display: flex;
				align-items: center;
				gap: 1rem;
				margin-top: 0.5rem;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
			}
			.tag {
				padding: 0.25rem 0.5rem;
				background: rgb(var(--accent));
				color: white;
				border-radius: 0.25rem;
				font-size: 0.75rem;
				text-decoration: none;
			}
			.site-name {
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
			@media (max-width: 720px) {
				.link-card {
					flex-direction: column;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<h1>Links</h1>
				<ul>
					{
						links.map((link) => (
							<li>
								<div class="link-card">
									<div class="link-content">
										<div class="link-header">
											{link.data.favicon && (
												<img src={link.data.favicon} alt="" class="link-favicon" />
											)}
											<h2 class="link-title">
												<a href={link.data.url} target="_blank" rel="noopener noreferrer">
													{link.data.title}
												</a>
											</h2>
										</div>
										{link.data.siteName && (
											<div class="site-name">{link.data.siteName}</div>
										)}
										<p class="link-description">{link.data.description}</p>
										<div class="link-meta">
											<p class="date">
												<FormattedDate date={link.data.pubDate} />
											</p>
											{link.data.tags && link.data.tags.length > 0 && (
												<div class="tags">
													{link.data.tags.map((tag) => (
														<a href={`/tags/${tag}/`} class="tag">{tag}</a>
													))}
												</div>
											)}
										</div>
									</div>
								</div>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
