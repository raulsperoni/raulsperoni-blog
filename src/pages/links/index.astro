---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const links = (await getCollection('links')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Links | ${SITE_TITLE}`} description="Interesting links and bookmarks" />
		<style>
			ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.link-card {
				margin-bottom: 3rem;
				padding-bottom: 3rem;
				border-bottom: 1px solid var(--border);
			}

			.link-card:last-child {
				border-bottom: none;
			}

			.link-header {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				margin-bottom: 0.75rem;
			}

			.link-favicon {
				width: 20px;
				height: 20px;
				flex-shrink: 0;
			}

			.link-title {
				margin: 0;
				font-size: 1.5rem;
				line-height: 1.3;
			}

			.link-title a {
				color: var(--text);
				text-decoration: none;
				border: none;
				transition: color 0.2s ease;
			}

			.link-title a:hover {
				color: var(--accent);
				border: none;
			}

			.site-name {
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
				font-size: 0.875rem;
				color: var(--text-light);
				margin-bottom: 0.5rem;
			}

			.link-description {
				margin: 0.75rem 0;
				color: var(--text);
			}

			.link-meta {
				display: flex;
				align-items: center;
				gap: 1rem;
				margin-top: 1rem;
			}

			.date {
				margin: 0;
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
				font-size: 0.875rem;
				color: var(--text-light);
			}

			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
			}

			.tag {
				padding: 0.375rem 0.75rem;
				background: var(--accent-light);
				color: var(--accent-dark);
				border-radius: var(--radius-sm);
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
				font-size: 0.8125rem;
				font-weight: 500;
				text-decoration: none;
				border: none;
				transition: all 0.2s ease;
			}

			.tag:hover {
				background: var(--accent);
				color: white;
				border: none;
			}

			@media (max-width: 720px) {
				.link-card {
					margin-bottom: 2rem;
					padding-bottom: 2rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main">
			<section>
				<h1>Links</h1>
				<ul>
					{
						links.map((link) => (
							<li>
								<div class="link-card">
									<div class="link-content">
										<div class="link-header">
											{link.data.favicon && (
												<img src={link.data.favicon} alt="" class="link-favicon" />
											)}
											<h2 class="link-title">
												<a href={link.data.url} target="_blank" rel="noopener noreferrer">
													{link.data.title}
												</a>
											</h2>
										</div>
										{link.data.siteName && (
											<div class="site-name">{link.data.siteName}</div>
										)}
										<p class="link-description">{link.data.description}</p>
										<div class="link-meta">
											<p class="date">
												<FormattedDate date={link.data.pubDate} />
											</p>
											{link.data.tags && link.data.tags.length > 0 && (
												<div class="tags">
													{link.data.tags.map((tag) => (
														<a href={`/tags/${tag}/`} class="tag">{tag}</a>
													))}
												</div>
											)}
										</div>
									</div>
								</div>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
