---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const recetas = (await getCollection('recetas')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={`Recetario — ${SITE_TITLE}`}
			description="Recetario del eterno amateur: pan de masa madre, focaccia y pizza. Recetas caseras, cantidades y aprendizajes."
		/>
		<style>
			.page-header {
				margin-bottom: 2.5rem;
				padding-bottom: 2rem;
				border-bottom: 1px solid var(--border);
			}

			.page-header h1 {
				font-size: 2.5rem;
				margin: 0 0 0.75rem;
				font-style: italic;
			}

			.page-lead {
				font-family: var(--font-body);
				font-size: 1rem;
				color: var(--text-light);
				line-height: 1.6;
				margin: 0 0 0.75rem;
				max-width: 46ch;
			}

			.post-count {
				font-family: var(--font-mono);
				font-size: 0.7rem;
				color: var(--text-light);
				text-transform: uppercase;
				letter-spacing: 0.08em;
				opacity: 0.7;
			}

			ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.entry {
				display: grid;
				grid-template-columns: 5.5rem 1fr;
				gap: 0 1.5rem;
				padding: 1.5rem 0;
				border-bottom: 1px solid var(--border);
				align-items: center;
			}

			ul li:last-child .entry {
				border-bottom: none;
			}

			.thumb {
				width: 5.5rem;
				height: 5.5rem;
				border-radius: var(--radius);
				overflow: hidden;
				background: var(--accent-light);
			}

			.thumb img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				margin: 0;
			}

			.content {
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
				min-width: 0;
			}

			.entry-title {
				font-family: var(--font-display);
				font-size: 1.375rem;
				font-weight: 700;
				line-height: 1.2;
				color: var(--text);
				text-decoration: none;
				border: none;
				transition: color 0.15s ease;
			}

			.entry-title:hover {
				color: var(--accent);
			}

			.entry-meta {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.4rem 0.6rem;
				font-family: var(--font-mono);
				font-size: 0.62rem;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				color: var(--text-light);
				opacity: 0.85;
			}

			.entry-meta .dot {
				opacity: 0.4;
			}

			@media (max-width: 720px) {
				.entry {
					grid-template-columns: 4rem 1fr;
					gap: 0 1rem;
				}

				.thumb {
					width: 4rem;
					height: 4rem;
				}

				.entry-title {
					font-size: 1.2rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main">
			<div class="page-header">
				<h1>Recetario</h1>
				<p class="page-lead">
					Del eterno amateur: pan de masa madre, focaccia y pizza. Cantidades,
					itinerarios y los aprendizajes de cada intento.
				</p>
				<p class="post-count">
					{recetas.length}
					{recetas.length === 1 ? 'receta' : 'recetas'}
				</p>
			</div>
			<ul>
				{
					recetas.map((receta) => (
						<li>
							<div class="entry">
								<a href={`/recetas/${receta.id}/`} class="thumb" aria-hidden="true" tabindex="-1">
									{receta.data.heroImage && (
										<Image src={receta.data.heroImage} alt="" width={160} height={160} />
									)}
								</a>
								<div class="content">
									<a href={`/recetas/${receta.id}/`} class="entry-title">
										{receta.data.title}
									</a>
									<div class="entry-meta">
										<FormattedDate date={receta.data.pubDate} />
										<span class="dot">·</span>
										<span>{receta.data.categoria}</span>
										{receta.data.hidratacion && (
											<>
												<span class="dot">·</span>
												<span>{receta.data.hidratacion} hidratación</span>
											</>
										)}
									</div>
								</div>
							</div>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
