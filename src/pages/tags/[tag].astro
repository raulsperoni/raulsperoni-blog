---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';

export const getStaticPaths = (async () => {
	const allPosts = await getCollection('blog');
	const allLinks = await getCollection('links');
	const allStrava = await getCollection('strava');
	const allGoodreads = await getCollection('goodreads');

	const allContent = [...allPosts, ...allLinks, ...allStrava, ...allGoodreads];
	const uniqueTags = [...new Set(allContent.flatMap(item => item.data.tags))];

	return uniqueTags.map((tag) => {
		const filteredPosts = allPosts.filter(post =>
			post.data.tags.includes(tag)
		).map(post => ({ ...post, type: 'blog' as const, url: `/blog/${post.id}/` }));

		const filteredLinks = allLinks.filter(link =>
			link.data.tags.includes(tag)
		).map(link => ({ ...link, type: 'link' as const, url: `/links/${link.id}/` }));

		const filteredStrava = allStrava.filter(activity =>
			activity.data.tags.includes(tag)
		).map(activity => ({ ...activity, type: 'strava' as const, url: null }));

		const filteredGoodreads = allGoodreads.filter(book =>
			book.data.tags.includes(tag)
		).map(book => ({ ...book, type: 'goodreads' as const, url: book.data.goodreadsUrl }));

		return {
			params: { tag },
			props: { content: [...filteredPosts, ...filteredLinks, ...filteredStrava, ...filteredGoodreads] },
		};
	});
}) satisfies GetStaticPaths;

const { tag } = Astro.params;
const { content } = Astro.props;

const sortedContent = content.sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Content tagged "${tag}"`} description={`All content tagged with ${tag}`} />
	</head>
	<body>
		<Header />
		<main id="main">
			<section>
				<h1>#{tag}</h1>
				<ul>
					{
						sortedContent.map((item) => {
							const isStrava = item.type === 'strava';
							const isGoodreads = item.type === 'goodreads';
							let stravaDetails = '';
							if (isStrava) {
								const distanceKm = (item.data.distance / 1000).toFixed(1);
								const paceMinPerKm = item.data.distance > 0
									? (item.data.movingTime / 60) / (item.data.distance / 1000)
									: 0;
								const paceFormatted = paceMinPerKm > 0
									? `${Math.floor(paceMinPerKm)}:${String(Math.round((paceMinPerKm % 1) * 60)).padStart(2, '0')}`
									: '';
								stravaDetails = ` — ${distanceKm} km${paceFormatted ? ` @ ${paceFormatted}/km` : ''}`;
							}
							const badge = isGoodreads ? (item.data as any).action : item.type;
							const coverImage = isGoodreads ? (item.data as any).coverImage : null;
							const author = isGoodreads ? (item.data as any).author : null;

							const content = (
								<>
									{coverImage && <img class="book-cover" src={coverImage} alt="" loading="lazy" />}
									<div class="item-text">
										<h4 class="title">{item.data.title}{isStrava && <span class="strava-details">{stravaDetails}</span>}</h4>
										<p class="date">
											{author && <span class="author">{author} · </span>}
											<FormattedDate date={item.data.pubDate} />
										</p>
									</div>
								</>
							);

							return (
								<li class={isGoodreads ? 'has-cover' : ''}>
									<span class={`content-type ${item.type}`}>{badge}</span>
									{item.url ? (
										<a href={item.url}>
											{content}
										</a>
									) : (
										<div class="no-link">
											{content}
										</div>
									)}
								</li>
							);
						})
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	h1 {
		margin-bottom: 2rem;
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	ul li {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		padding: 1rem 0;
		border-bottom: 1px solid var(--border);
	}

	ul li.has-cover {
		align-items: center;
	}

	.book-cover {
		width: 40px;
		height: auto;
		border-radius: 2px;
		margin: 0;
		flex-shrink: 0;
		object-fit: cover;
	}

	.item-text {
		flex: 1;
		min-width: 0;
	}

	.author {
		color: var(--text-light);
		font-style: italic;
	}

	ul li:last-child {
		border-bottom: none;
	}

	.content-type {
		flex-shrink: 0;
		padding: 0.25rem 0.5rem;
		background: var(--accent-light);
		color: var(--accent-dark);
		border-radius: 3px;
		font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		font-size: 0.6875rem;
		text-transform: uppercase;
		font-weight: 600;
		letter-spacing: 0.05em;
	}

	.content-type.blog {
		background: var(--accent);
		color: white;
	}

	.content-type.strava {
		background: #fc4c02;
		color: white;
	}

	.content-type.goodreads {
		background: #553b08;
		color: white;
	}

	ul li a,
	ul li .no-link {
		flex: 1;
		text-decoration: none;
		border: none;
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.title {
		margin: 0 0 0.5rem 0;
		color: var(--text);
		line-height: 1.3;
		font-size: 1.25rem;
		transition: color 0.2s ease;
	}

	.date {
		margin: 0;
		font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		font-size: 0.875rem;
		color: var(--text-light);
	}

	ul li:hover .title {
		color: var(--accent);
	}

	@media (max-width: 720px) {
		ul li {
			flex-direction: column;
			gap: 0.5rem;
		}
	}
</style>
