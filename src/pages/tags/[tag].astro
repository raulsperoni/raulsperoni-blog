---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';

export const getStaticPaths = (async () => {
	const allPosts = await getCollection('blog');
	const allLinks = await getCollection('links');

	const allContent = [...allPosts, ...allLinks];
	const uniqueTags = [...new Set(allContent.flatMap(item => item.data.tags))];

	return uniqueTags.map((tag) => {
		const filteredPosts = allPosts.filter(post =>
			post.data.tags.includes(tag)
		).map(post => ({ ...post, type: 'blog' as const, url: `/blog/${post.id}/` }));

		const filteredLinks = allLinks.filter(link =>
			link.data.tags.includes(tag)
		).map(link => ({ ...link, type: 'link' as const, url: `/links/${link.id}/` }));

		return {
			params: { tag },
			props: { content: [...filteredPosts, ...filteredLinks] },
		};
	});
}) satisfies GetStaticPaths;

const { tag } = Astro.params;
const { content } = Astro.props;

const sortedContent = content.sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Content tagged "${tag}"`} description={`All content tagged with ${tag}`} />
	</head>
	<body>
		<Header />
		<main>
			<section>
				<h1>#{tag}</h1>
				<ul>
					{
						sortedContent.map((item) => (
							<li>
								<span class={`content-type ${item.type}`}>{item.type}</span>
								<a href={item.url}>
									<h4 class="title">{item.data.title}</h4>
									<p class="date">
										<FormattedDate date={item.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	h1 {
		margin-bottom: 2rem;
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	ul li {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		padding: 1rem 0;
		border-bottom: 1px solid var(--border);
	}

	ul li:last-child {
		border-bottom: none;
	}

	.content-type {
		flex-shrink: 0;
		padding: 0.25rem 0.5rem;
		background: var(--accent-light);
		color: var(--accent-dark);
		border-radius: 3px;
		font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		font-size: 0.6875rem;
		text-transform: uppercase;
		font-weight: 600;
		letter-spacing: 0.05em;
	}

	.content-type.blog {
		background: var(--accent);
		color: white;
	}

	ul li a {
		flex: 1;
		text-decoration: none;
		border: none;
	}

	.title {
		margin: 0 0 0.5rem 0;
		color: var(--text);
		line-height: 1.3;
		font-size: 1.25rem;
		transition: color 0.2s ease;
	}

	.date {
		margin: 0;
		font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		font-size: 0.875rem;
		color: var(--text-light);
	}

	ul li:hover .title {
		color: var(--accent);
	}

	@media (max-width: 720px) {
		ul li {
			flex-direction: column;
			gap: 0.5rem;
		}
	}
</style>
