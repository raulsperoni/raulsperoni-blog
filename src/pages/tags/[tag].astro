---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';

export const getStaticPaths = (async () => {
	const allPosts = await getCollection('blog');
	const allLinks = await getCollection('links');

	const allContent = [...allPosts, ...allLinks];
	const uniqueTags = [...new Set(allContent.flatMap(item => item.data.tags))];

	return uniqueTags.map((tag) => {
		const filteredPosts = allPosts.filter(post =>
			post.data.tags.includes(tag)
		).map(post => ({ ...post, type: 'blog' as const, url: `/blog/${post.id}/` }));

		const filteredLinks = allLinks.filter(link =>
			link.data.tags.includes(tag)
		).map(link => ({ ...link, type: 'link' as const, url: `/links/${link.id}/` }));

		return {
			params: { tag },
			props: { content: [...filteredPosts, ...filteredLinks] },
		};
	});
}) satisfies GetStaticPaths;

const { tag } = Astro.params;
const { content } = Astro.props;

const sortedContent = content.sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Content tagged "${tag}"`} description={`All content tagged with ${tag}`} />
	</head>
	<body>
		<Header />
		<main>
			<section>
				<h1>#{tag}</h1>
				<ul>
					{
						sortedContent.map((item) => (
							<li>
								<span class={`content-type ${item.type}`}>{item.type}</span>
								<a href={item.url}>
									<h4 class="title">{item.data.title}</h4>
									<p class="date">
										<FormattedDate date={item.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 960px;
	}
	h1 {
		margin-bottom: 2rem;
	}
	ul {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		list-style-type: none;
		margin: 0;
		padding: 0;
	}
	ul li {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		padding: 1rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 0.5rem;
		transition: 0.2s ease;
	}
	ul li:hover {
		border-color: rgb(var(--accent));
		box-shadow: 0 2px 8px rgba(var(--black), 10%);
	}
	.content-type {
		flex-shrink: 0;
		padding: 0.125rem 0.5rem;
		background: rgb(var(--gray-light));
		color: rgb(var(--gray-dark));
		border-radius: 0.25rem;
		font-size: 0.75rem;
		text-transform: uppercase;
		font-weight: 500;
	}
	.content-type.blog {
		background: rgb(var(--accent));
		color: white;
	}
	ul li a {
		flex: 1;
		text-decoration: none;
	}
	.title {
		margin: 0 0 0.25rem 0;
		color: rgb(var(--black));
		line-height: 1.2;
	}
	.date {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.875rem;
	}
	ul li:hover .title {
		color: rgb(var(--accent));
	}
	@media (max-width: 720px) {
		ul li {
			flex-direction: column;
			gap: 0.5rem;
		}
	}
</style>
