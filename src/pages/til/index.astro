---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('til')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={`TIL — ${SITE_TITLE}`}
			description="Short technical notes about things I learned — programming, tools, infrastructure."
		/>
		<style>
			.page-header {
				margin-bottom: 3rem;
				padding-bottom: 2rem;
				border-bottom: 1px solid var(--border);
			}

			.page-header h1 {
				font-size: 2.5rem;
				margin: 0 0 0.5rem;
				font-style: italic;
			}

			.post-count {
				font-family: var(--font-mono);
				font-size: 0.7rem;
				color: var(--text-light);
				text-transform: uppercase;
				letter-spacing: 0.08em;
				opacity: 0.7;
			}

			ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}

			ul li {
				margin-bottom: 0;
			}

			.post-entry {
				display: grid;
				grid-template-columns: 6rem 1fr;
				gap: 0 2rem;
				padding: 1.875rem 0;
				border-bottom: 1px solid var(--border);
				align-items: start;
				transition: background 0.1s ease;
			}

			ul li:last-child .post-entry {
				border-bottom: none;
			}

			.post-date {
				font-family: var(--font-mono);
				font-size: 0.65rem;
				color: var(--text-light);
				text-transform: uppercase;
				letter-spacing: 0.06em;
				padding-top: 0.45rem;
				opacity: 0.7;
				line-height: 1.4;
			}

			.post-content {
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
			}

			.post-title {
				font-family: var(--font-display);
				font-size: 1.5rem;
				font-weight: 700;
				line-height: 1.2;
				letter-spacing: -0.01em;
				color: var(--text);
				text-decoration: none;
				border: none;
				transition: color 0.15s ease;
				display: block;
			}

			.post-title:hover {
				color: var(--accent);
				border: none;
			}

			.post-description {
				font-family: var(--font-body);
				font-size: 0.9375rem;
				color: var(--text-light);
				line-height: 1.6;
				margin: 0;
			}

			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.375rem;
				margin-top: 0.25rem;
			}

			.tag {
				padding: 0.2rem 0.5rem;
				background: transparent;
				color: var(--text-light);
				border: 1px solid var(--border);
				border-radius: var(--radius-sm);
				text-decoration: none;
				font-family: var(--font-mono);
				font-size: 0.6rem;
				text-transform: lowercase;
				letter-spacing: 0.04em;
				transition: all 0.15s ease;
			}

			.tag:hover {
				background: var(--accent);
				color: var(--bg-elevated);
				border-color: var(--accent);
			}

			.tag::before {
				content: '#';
				opacity: 0.5;
			}

			@media (max-width: 720px) {
				.post-entry {
					grid-template-columns: 1fr;
					gap: 0.5rem;
					padding: 1.5rem 0;
				}

				.post-date {
					padding-top: 0;
				}

				.post-title {
					font-size: 1.375rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main">
			<div class="page-header">
				<h1>TIL</h1>
				<p class="post-count">
					{posts.length}
					{posts.length === 1 ? 'entrada' : 'entradas'}
				</p>
			</div>
			<ul>
				{
					posts.map((post) => (
						<li>
							<div class="post-entry">
								<div class="post-date">
									<FormattedDate
										date={post.data.pubDate}
									/>
								</div>
								<div class="post-content">
									<a
										href={`/til/${post.id}/`}
										class="post-title"
									>
										{post.data.title}
									</a>
									{post.data.description && (
										<p class="post-description">
											{post.data.description}
										</p>
									)}
									{post.data.tags &&
										post.data.tags.length > 0 && (
											<div class="tags">
												{post.data.tags.map(
													(tag) => (
														<a
															href={`/tags/${tag}/`}
															class="tag"
														>
															{tag}
														</a>
													),
												)}
											</div>
										)}
								</div>
							</div>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
